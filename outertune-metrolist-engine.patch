index 305c846..e555cbd 100644
--- a/app/src/main/java/com/dd3boh/outertune/widget/WidgetLyrics.kt
+++ b/app/src/main/java/com/dd3boh/outertune/widget/WidgetLyrics.kt
@@ -28,10 +28,14 @@ object WidgetLyrics {
     data class Frame(val previous: String?, val current: String, val sungChars: Int, val next: String?)
 
     /**
-     * How far ahead the lit words run. The widget is redrawn about once a second, so lighting what
-     * is sung half a second from now puts each word, on average, on time.
+     * How far ahead the lit words run: about how long a redraw takes to get through the launcher, so
+     * a word lights on time rather than just after it is sung.
      */
-    private const val LEAD_MS = 500L
+    private const val LEAD_MS = 300L
+
+    /** The shortest and longest wait between redraws - see [nextChangeDelay]. */
+    private const val MIN_DELAY_MS = 200L
+    private const val MAX_DELAY_MS = 2_000L
 
     /** Timed lines, in order. Empty for unsynced lyrics - there is no "current line" to show then. */
     fun parse(raw: String?, estimate: Boolean): List<Line> {
@@ -69,6 +73,21 @@ object WidgetLyrics {
         return Frame(lines.getOrNull(index - 1)?.text, line.text, sung, lines.getOrNull(index + 1)?.text)
     }
 
+    /**
+     * How long until the widget next needs redrawing for [positionMs]: when the next word is due to
+     * light (less the lead) or the next line starts, whichever is first. Redrawing on a fixed
+     * second instead lit words up to a second late, which read as slow, stepping lyrics.
+     */
+    fun nextChangeDelay(lines: List<Line>, positionMs: Long): Long {
+        val index = lines.indexOfLast { it.start <= positionMs }
+        var next = lines.getOrNull(index + 1)?.start ?: Long.MAX_VALUE
+        if (index >= 0) {
+            lines[index].words.firstOrNull { it.first > positionMs + LEAD_MS }
+                ?.let { next = minOf(next, it.first - LEAD_MS) }
+        }
+        return if (next == Long.MAX_VALUE) MAX_DELAY_MS else (next - positionMs).coerceIn(MIN_DELAY_MS, MAX_DELAY_MS)
+    }
+
     /** Whether any line carries word timings, so the widget is worth redrawing more often. */
     fun hasWords(lines: List<Line>) = lines.any { it.words.isNotEmpty() }
 }
