From 9d942e811c8c7e451678484cb3eb724c5a0e7eb4 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 24 Oct 2026 20:04:24 +0800
Subject: [PATCH 480/547] Android lyrics: the last line sweeps too, and the
 sweep no longer twitches back

The LRC parser ends the final line at Long.MAX_VALUE for want of a next one, and the word estimate
gave up on any line that long - so the last line of every song (and any line followed by a long
break) was left unlit. Such a line is now timed from the song's own pace, the same estimate every
other line is capped by.

A fresh position report could land a few milliseconds behind where the sweep had extrapolated to,
drawing as a small step back. Steps back under 250 ms are held; a real seek is far larger.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dd3boh/outertune/ui/component/Lyrics.kt    | 11 +++++++++--
 .../outertune/ui/utils/EstimatedWordSync.kt    | 14 ++++++++------
 .../ui/utils/EstimatedWordSyncTest.kt          | 18 ++++++++++++++++--
 3 files changed, 33 insertions(+), 10 deletions(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt b/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt
index 7aea4f463..ecf91d7ac 100644
--- a/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt
+++ b/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt
@@ -272,9 +272,14 @@ fun Lyrics(
                     latchedPosition = reported
                     latchedAt = now
                 }
+                val next = latchedPosition + lyricOffset +
+                    if (playerConnection.player.isPlaying) now - latchedAt else 0L
+                // The player reports its position in steps, and a fresh report can land a few
+                // milliseconds behind where the extrapolation had got to - which drew as the sweep
+                // twitching backwards. Small steps back are held; a real seek is far larger.
+                val shown = karaokePosition.longValue
                 karaokePosition.longValue =
-                    latchedPosition + lyricOffset +
-                        if (playerConnection.player.isPlaying) now - latchedAt else 0L
+                    if (next < shown && shown - next < MAX_HELD_STEP_BACK_MS) shown else next
             }
             // Frame-synced while something is moving, idle polling otherwise, so a paused player
             // with the lyrics open does not hold the choreographer awake.
@@ -591,4 +596,6 @@ private const val CONSUMED_ALPHA = 0.65f
  * How often the karaoke position is refreshed when nothing is moving. Only exists so that a seek
  * made while paused still lands on screen; the sweep is frame-synced whenever it is actually moving.
  */
+/** How far back a position report may land and be held, rather than taken as a seek. */
+private const val MAX_HELD_STEP_BACK_MS = 250L
 private const val IDLE_KARAOKE_REFRESH_MS = 250L
diff --git a/app/src/main/java/com/dd3boh/outertune/ui/utils/EstimatedWordSync.kt b/app/src/main/java/com/dd3boh/outertune/ui/utils/EstimatedWordSync.kt
