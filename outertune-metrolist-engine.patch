+                  GROUP BY sam.artistId) AS ranked
+                 ON ranked.rankedArtistId = artist.id
+        ORDER BY (CASE WHEN :byPlayTime THEN ranked.totalPlayTime ELSE ranked.totalPlays END) DESC
+        LIMIT :limit
+    """)
+    fun mostPlayedArtistStats(
+        fromTimeStamp: Long,
