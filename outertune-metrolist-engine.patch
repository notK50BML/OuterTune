+import com.kyant.backdrop.backdrops.LayerBackdrop
+import com.kyant.backdrop.backdrops.layerBackdrop
+import com.kyant.backdrop.backdrops.rememberLayerBackdrop
+
+/*
+ * Glass for controls that sit INSIDE a screen (the floating buttons).
+ *
+ * They cannot read a backdrop of the screen from where they are composed: that layer would contain
+ * its own reader, and the native stack overflows. So the screens are recorded into a backdrop of
+ * their own, and a control hands its drawing to the host, which draws it over the screens, outside
+ * that layer. The control is still laid out, and still takes touches, where it is composed.
+ */
+
+/** The screens' backdrop and the controls drawn over them. */
+@Stable
+class GlassHost internal constructor(val backdrop: LayerBackdrop) {
+    internal var coordinates: LayoutCoordinates? = null
+    internal val hosted = mutableStateListOf<HostedControl>()
+}
+
+@Stable
+internal class HostedControl(val layer: GraphicsLayer) {
+    var coordinates: LayoutCoordinates? = null
+    var offset by mutableStateOf(Offset.Zero)
+
+    fun place(host: LayoutCoordinates) {
+        val own = coordinates ?: return
+        if (host.isAttached && own.isAttached) offset = host.localPositionOf(own, Offset.Zero)
+    }
+}
+
+/** The host for the screens under it, or null when glass is off for them and they draw themselves. */
+val LocalGlassHost = staticCompositionLocalOf<GlassHost?> { null }
+
+/** Wraps the nav host. With [enabled] false this is a plain full size box that records nothing. */
+@Composable
+fun GlassHostBox(enabled: Boolean, content: @Composable () -> Unit) {
+    val surface = rememberUpdatedState(MaterialTheme.colorScheme.surface)
+    val host = if (enabled) {
+        // Recorded over the page colour, read inside the draw so a new colour re-records the layer.
+        val onDraw = remember {
+            val draw: ContentDrawScope.() -> Unit = {
+                drawRect(surface.value)
+                drawContent()
+            }
+            draw
+        }
+        val backdrop = rememberLayerBackdrop(onDraw = onDraw)
+        remember(backdrop) { GlassHost(backdrop) }
+    } else null
+
+    Box(
+        Modifier
+            .fillMaxSize()
+            .then(
+                if (host != null) Modifier.onGloballyPositioned { c ->
+                    host.coordinates = c
+                    host.hosted.forEach { it.place(c) }
+                } else Modifier
+            )
+    ) {
+        Box(
+            Modifier
+                .fillMaxSize()
+                .then(if (host != null) Modifier.layerBackdrop(host.backdrop).graphicsLayer() else Modifier)
+        ) {
+            CompositionLocalProvider(LocalGlassHost provides host) { content() }
+        }
+        if (host != null) {
+            Spacer(
+                Modifier
+                    .matchParentSize()
+                    .drawBehind {
+                        host.hosted.forEach { c -> translate(c.offset.x, c.offset.y) { drawLayer(c.layer) } }
+                    }
+            )
+        }
+    }
+}
+
+/** Hands this control's drawing to [host]: recorded into a layer of its own and drawn by the host. */
+@Composable
+fun Modifier.drawnBy(host: GlassHost): Modifier {
+    val layer = rememberGraphicsLayer()
+    val control = remember(layer) { HostedControl(layer) }
+    DisposableEffect(host, control) {
+        host.hosted += control
+        host.coordinates?.let(control::place)
+        onDispose { host.hosted -= control }
+    }
+    return this
+        .onGloballyPositioned { c ->
+            control.coordinates = c
+            host.coordinates?.let(control::place)
+        }
+        .drawWithContent { layer.record { this@drawWithContent.drawContent() } }
+}
