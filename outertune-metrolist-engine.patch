@@ -0,0 +1,125 @@
+/*
+ * Copyright (C) 2026 OuterTune Project
+ *
+ * SPDX-License-Identifier: GPL-3.0
+ *
+ * Ported from InterTune's liquid glass (kyant0 backdrop).
+ */
+
+package com.dd3boh.outertune.ui.utils
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.systemBars
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.surfaceColorAtElevation
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.Immutable
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.runtime.staticCompositionLocalOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.lerp
+import androidx.compose.ui.util.lerp
+import com.kyant.backdrop.backdrops.LayerBackdrop
+import com.kyant.backdrop.drawBackdrop
+import com.kyant.backdrop.effects.blur
+import com.kyant.backdrop.effects.lens
+import com.kyant.backdrop.effects.vibrancy
+
+/**
+ * The app's page content, published as a backdrop for glass panels to refract. Null when liquid
+ * glass is off or this device cannot draw it (it needs Android 13 for the lens shader).
+ *
+ * A layer must never contain one of its own readers: that makes RenderNode::prepareTreeImpl recurse
+ * until the native stack overflows and the process dies with no Java exception. So only panels
+ * drawn OUTSIDE the nav host (the dock, the player sheet, the top bar) read it.
+ */
+val LocalAppBackdrop = staticCompositionLocalOf<LayerBackdrop?> { null }
+
+/** Which glass is switched on, and how strong. Provided by MainActivity next to [LocalAppBackdrop]. */
+@Immutable
+data class GlassConfig(val dock: Boolean = true, val topBar: Boolean = true, val intensity: Float = 0.5f)
+
+val LocalGlassConfig = staticCompositionLocalOf { GlassConfig() }
+
+enum class GlassKind { DOCK, TOP_BAR }
+
+/**
+ * Resolved numbers for one panel, all derived from the single intensity slider ("how much glass"):
+ * more intensity is clearer and more strongly bent, never more opaque.
+ */
+@Immutable
+data class GlassSpec(val backdrop: LayerBackdrop, val intensity: Float) {
+    private val t get() = intensity.coerceIn(0f, 1f)
+
+    /** How much the panel hides what is behind it. Falls as intensity rises. */
+    val frost: Float get() = 1f - kotlin.math.sqrt(t)
+
+    /** Blur behind the panel. */
+    val blur: Dp get() = lerp(6.dp, 32.dp, frost)
+
+    /** Lens strength; floored because lens() with 0 drops the rounded shape. */
+    val lensT: Float get() = t.coerceIn(0.15f, 1f)
+
+    /** Tint opacity; never near zero, or text behind fights the text on the panel. */
+    fun tintAlpha(min: Float = 0.52f, max: Float = 0.97f): Float = lerp(min, max, frost)
+
+    @Composable
+    fun tint(elevation: Dp = 6.dp, min: Float = 0.62f, max: Float = 0.97f): Color =
+        MaterialTheme.colorScheme.surfaceColorAtElevation(elevation).copy(alpha = tintAlpha(min, max))
+}
+
+/** The glass for [kind], or null when it is off, unavailable here, or switched off for that place. */
+@Composable
+fun rememberGlass(kind: GlassKind): GlassSpec? {
+    val backdrop = LocalAppBackdrop.current ?: return null
+    val config = LocalGlassConfig.current
+    val on = when (kind) {
+        GlassKind.DOCK -> config.dock
+        GlassKind.TOP_BAR -> config.topBar
+    }
+    return if (on) GlassSpec(backdrop, config.intensity) else null
+}
+
+/** [shape] filled with glass over [GlassSpec.backdrop], then the tint. The caller makes sure this node is not inside the recorded layer. */
+@Composable
+fun Modifier.glassPanel(glass: GlassSpec, shape: Shape, tint: Color = glass.tint()): Modifier {
+    val currentShape = rememberUpdatedState(shape)
+    val shapeProvider = remember { { currentShape.value } }
+    return this
+        .drawBackdrop(
+            backdrop = glass.backdrop,
+            shape = shapeProvider,
+            effects = {
+                vibrancy()
+                blur(glass.blur.toPx())
+                lens(
+                    refractionHeight = 12f.dp.toPx() * glass.lensT,
+                    refractionAmount = 24f.dp.toPx() * glass.lensT,
+                    depthEffect = true,
+                )
+            },
+        )
+        // Tint as a background after the backdrop: on the node's own canvas it would paint a square.
+        .background(tint, shape)
+}
+
+/**
+ * How far the floating dock stands off the bottom of the screen. One number for the panel (drawn by
+ * the player sheet) and the tabs (drawn by MainActivity), so the tabs sit inside the panel.
+ */
+@Composable
+fun glassDockBottomPadding(): Dp {
+    val density = LocalDensity.current
+    val inset = with(density) { WindowInsets.systemBars.getBottom(density).toDp() }
+    return (inset - 4.dp).coerceAtLeast(6.dp)
+}
+
+/** Space between the dock and the screen's side edges. */
+val GlassDockSidePadding = 12.dp
