+/**
+ * The back arrow every settings screen's top bar shares: tap goes back, long press goes home.
+ * Glass in a circle when liquid glass is on for controls, drawn by the glass host because it sits
+ * inside the screen (see GlassHost.kt); a plain icon button otherwise.
+ */
+@Composable
+fun BackButton(navController: NavController) {
+    val host = LocalGlassHost.current
+    val config = LocalGlassConfig.current
+    val glass = if (host != null && config.controls) GlassSpec(host.backdrop, config.intensity) else null
+    IconButton(
+        onClick = navController::navigateUp,
+        onLongClick = navController::backToMain,
+        modifier = if (host != null && glass != null) {
+            Modifier.drawnBy(host).graphicsLayer().glassPanel(glass, CircleShape)
+        } else Modifier,
+    ) {
+        Icon(Icons.AutoMirrored.Rounded.ArrowBack, contentDescription = stringResource(R.string.action_back))
+    }
+}
