+  const W = scr.width / d, H = scr.height / d;
+  const nav = navMode === "buttons" ? DP.navButtons : DP.navGesture;
+  const area = { x: 0, y: DP.status, w: W, h: H - DP.status - nav - DP.peek - DP.spacer };
+  return { W, H, nav, area };
+}
+
+/** How tall a block is drawn, in dp (scale is a transform and does not change it). */
+function naturalH(id, wDp) {
+  if (id === "artwork") return wDp;
