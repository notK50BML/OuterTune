+    internal fun creditsToAppend(
+        existing: List<ArtistEntity>,
+        incoming: List<MediaMetadata.Artist>,
+    ): List<MediaMetadata.Artist> {
+        val real = incoming.filter { it.hasArtistPage && it.name.isNotBlank() && " & " !in it.name }
