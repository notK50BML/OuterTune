From c041cb2cf47c1622367d56ce384707e9e49d5476 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Thu, 22 Oct 2026 19:26:29 +0800
Subject: [PATCH 444/547] Desktop equaliser: put the spectrum where its
 frequencies are

The analyser's 28 bands are log-spaced from 40Hz, but the graph placed them as if they were linear
FFT bins - the lowest band landed at about 400Hz and the whole spectrum crowded into the right of
the curve, so no peak sat over the part of the curve that governs it. Both now take each band's
edges from SpectrumAnalyzer.bandEdgeHz, so they cannot disagree again. SpectrumBandsTest pins it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dd3boh/outertune/desktop/AudioSpectrum.kt | 20 ++++++---
 .../com/dd3boh/outertune/desktop/EqGraph.kt   | 21 ++++++----
 .../outertune/desktop/SpectrumBandsTest.kt    | 42 +++++++++++++++++++
 3 files changed, 69 insertions(+), 14 deletions(-)
 create mode 100644 desktop/src/test/kotlin/com/dd3boh/outertune/desktop/SpectrumBandsTest.kt

diff --git a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/AudioSpectrum.kt b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/AudioSpectrum.kt
index c221eca0b..02433d51a 100644
--- a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/AudioSpectrum.kt
+++ b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/AudioSpectrum.kt
@@ -275,14 +275,13 @@ class SpectrumAnalyzer(
     /** Which FFT bin each band starts at. */
     private val edges: IntArray = run {
         val nyquist = sampleRate / 2.0
-        val low = 40.0
-        val high = min(16_000.0, nyquist * 0.98)
         IntArray(bands + 1) { b ->
-            val hz = low * (high / low).pow(b.toDouble() / bands)
+            val hz = bandEdgeHz(b.toDouble(), bands, sampleRate)
             (hz / nyquist * (size / 2)).toInt().coerceIn(0, size / 2 - 1)
         }
     }
 
+
     /**
      * Folds one block of mono samples into the bars and returns them.
      *
@@ -330,9 +329,20 @@ class SpectrumAnalyzer(
         levels.fill(0f)
     }
 
-    private companion object {
+    companion object {
         /** Quietest level shown. Below this is silence as far as the display is concerned. */
-        const val FLOOR_DB = -70.0
+        private const val FLOOR_DB = -70.0
+        private const val LOW_HZ = 40.0
+
+        /**
+         * Where band [position] begins, in hertz - fractional positions fall between edges, so
+         * `b + 0.5` is band b's centre on the log axis. Shared with anything that draws these bands
+         * against a frequency axis (EqGraph), so the two cannot disagree about where a band is.
+         */
+        fun bandEdgeHz(position: Double, bands: Int, sampleRate: Int): Double {
+            val high = min(16_000.0, sampleRate / 2.0 * 0.98)
+            return LOW_HZ * (high / LOW_HZ).pow(position / bands)
+        }
     }
 }
 
