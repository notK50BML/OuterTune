+package com.dd3boh.outertune.playback
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFocusRequest
+import android.media.AudioManager
+import androidx.media3.common.Player
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+
+/**
+ * Replaces the player's own audio focus handling, which cuts the volume to a fixed fraction the
+ * instant a notification sound asks to duck. This eases down quickly, and when the other sound
+ * is done, back up slowly. Pausing for calls and other apps' playback is kept as the player does it.
+ *
+ * Everything here runs on the main thread (the focus callback is delivered there).
+ */
+class SmoothDucker(
+    context: Context,
+    private val scope: CoroutineScope,
+    private val player: Player,
+    /** Multiplied into the player volume by the service; 1f = untouched. */
+    val factor: MutableStateFlow<Float>,
+) {
+    private val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+    private var request: AudioFocusRequest? = null
+    private var fade: Job? = null
+    private var pausedByFocus = false
+    private var enabled = false
+
+    private val playerListener = object : Player.Listener {
+        override fun onPlayWhenReadyChanged(playWhenReady: Boolean, reason: Int) {
+            if (!enabled) return
+            if (playWhenReady) requestFocus()
+            else if (reason != Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_FOCUS_LOSS) {
+                pausedByFocus = false
+            }
+        }
+    }
+
+    private val focusListener = AudioManager.OnAudioFocusChangeListener { change ->
+        when (change) {
+            AudioManager.AUDIOFOCUS_GAIN -> {
+                fadeTo(1f, FADE_UP_MS)
+                if (pausedByFocus) {
+                    pausedByFocus = false
+                    player.play()
+                }
+            }
+            AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK -> fadeTo(DUCK_LEVEL, FADE_DOWN_MS)
+            AudioManager.AUDIOFOCUS_LOSS_TRANSIENT -> {
+                if (player.playWhenReady) {
+                    pausedByFocus = true
+                    player.pause()
+                }
+            }
+            AudioManager.AUDIOFOCUS_LOSS -> {
+                pausedByFocus = false
+                player.pause()
+                abandonFocus()
+            }
+        }
+    }
+
+    fun enable() {
+        if (enabled) return
+        enabled = true
+        player.addListener(playerListener)
+        if (player.playWhenReady) requestFocus()
+    }
+
+    fun disable() {
+        if (!enabled) return
+        enabled = false
+        player.removeListener(playerListener)
+        fade?.cancel()
+        factor.value = 1f
+        pausedByFocus = false
+        abandonFocus()
+    }
+
+    private fun requestFocus() {
+        if (request != null) return
+        val req = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
+            .setAudioAttributes(
+                AudioAttributes.Builder()
+                    .setUsage(AudioAttributes.USAGE_MEDIA)
+                    .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                    .build()
+            )
+            .setOnAudioFocusChangeListener(focusListener)
+            // Pausing is for us to decide; the system would otherwise silence us on its own.
+            .setWillPauseWhenDucked(false)
+            .build()
+        request = req
+        audioManager.requestAudioFocus(req)
+    }
+
+    private fun abandonFocus() {
+        request?.let { audioManager.abandonAudioFocusRequest(it) }
+        request = null
+    }
+
+    private fun fadeTo(target: Float, durationMs: Long) {
+        fade?.cancel()
+        val from = factor.value
+        if (from == target) return
+        fade = scope.launch {
+            val steps = (durationMs / STEP_MS).toInt().coerceAtLeast(1)
+            for (i in 1..steps) {
+                if (!isActive) return@launch
+                factor.value = from + (target - from) * (i / steps.toFloat())
+                delay(STEP_MS)
+            }
+            factor.value = target
+        }
+    }
+
+    private companion object {
+        const val DUCK_LEVEL = 0.2f
+        const val FADE_DOWN_MS = 300L
+        const val FADE_UP_MS = 3000L
+        const val STEP_MS = 50L
+    }
+}
