+        assertEquals(4000uL, words.first().timeRange.first)
+        // Four lines' worth of pace, not the rest of time: the same couple of seconds as the others.
+        assertTrue(words.last().timeRange.last in 5000uL..9000uL)
     }
 
     @Test
