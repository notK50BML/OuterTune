+            val deduped = mutableListOf<ArtistEntity>()
+            for (artist in finalArtists) {
+                val key = artist.name.trim().lowercase()
+                if (key !in duplicatedNames) {
+                    deduped += artist
+                } else if (winners[key]?.id == artist.id && deduped.none { it.id == artist.id }) {
+                    deduped += artist
