diff --git a/app/src/test/java/com/dd3boh/outertune/models/ToneShelfTest.kt b/app/src/test/java/com/dd3boh/outertune/models/ToneShelfTest.kt
new file mode 100644
index 000000000..d9e03aae0
--- /dev/null
