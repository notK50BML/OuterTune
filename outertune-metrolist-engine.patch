From 016f319201a9a84dc9417b0b79d1c8c06d4e26ab Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Mon, 26 Oct 2026 18:50:15 +0800
Subject: [PATCH 519/547] Desktop: the seek bar stays while a song loads, radio
 keeps its song, less memory

The player has no length for a song still being fetched, and the seek bar
hid itself for those seconds - between every two songs. The song's own
length stands in, and the bar never disappears. Starting a radio from the
playing song no longer restarts it. The heap starts at 48MB instead of the
whole 320MB cap (the JVM's default on a machine with 20GB+), and cached
covers are limited to 64MB of pixels rather than sixty of any size.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 desktop/build.gradle.kts                      |  4 ++--
 .../com/dd3boh/outertune/desktop/Artwork.kt   | 19 +++++++++++++++----
 .../com/dd3boh/outertune/desktop/Main.kt      | 15 +++++++++++----
 .../outertune/desktop/NowPlayingScreen.kt     | 10 ++++++----
 .../dd3boh/outertune/desktop/PlayerQueue.kt   | 13 +++++++++++--
 5 files changed, 45 insertions(+), 16 deletions(-)

diff --git a/desktop/build.gradle.kts b/desktop/build.gradle.kts
index 16450f5e0..c7cce3e46 100644
--- a/desktop/build.gradle.kts
+++ b/desktop/build.gradle.kts
@@ -127,7 +127,7 @@ tasks.register<JavaExec>("run") {
     description = "Runs the OuterTune desktop client."
     mainClass.set("com.dd3boh.outertune.desktop.MainKt")
     classpath = sourceSets["main"].runtimeClasspath
-    jvmArgs("-Xmx320m", "-XX:+UseSerialGC", "-XX:MaxMetaspaceSize=192m")
+    jvmArgs("-Xms48m", "-Xmx320m", "-XX:+UseSerialGC", "-XX:MinHeapFreeRatio=15", "-XX:MaxHeapFreeRatio=40", "-XX:MaxMetaspaceSize=192m")
 }
 
 /** `gradlew :desktop:cdpProbe` - the smallest thing CdpSession must do, step by step. */
@@ -404,7 +404,7 @@ val appImage = tasks.register<Exec>("appImage") {
         // jar and every later start maps them in already parsed and verified, instead of reading
         // and checking thousands of classes out of the jar each time. Where the folder is not
         // writable (an all-users install in Program Files) the JVM skips it and starts as before.
-        "--java-options", "-Xmx320m -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m " +
+        "--java-options", "-Xms48m -Xmx320m -XX:+UseSerialGC -XX:MinHeapFreeRatio=15 -XX:MaxHeapFreeRatio=40 -XX:MaxMetaspaceSize=192m " +
             "-XX:+AutoCreateSharedArchive -XX:SharedArchiveFile=\$APPDIR/app.jsa",
     )
 }
diff --git a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
index ff7a5dcb6..3533ec661 100644
--- a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
+++ b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
@@ -55,7 +55,14 @@ import java.util.Collections
  * of a visible image, which is not worth an LRU.
  */
 internal object ArtworkCache {
-    private const val MAX_ENTRIES = 60
+    private const val MAX_ENTRIES = 120
+
+    /**
+     * Decoded pixels kept, in bytes. A count alone let sixty 1080px player covers - near 5MB each
+     * once decoded - hold close to 300MB outside the Java heap, where nothing else limits it.
+     */
+    private const val MAX_PIXEL_BYTES = 64L * 1024 * 1024
+    private val ImageBitmap.pixelBytes: Long get() = width.toLong() * height * 4
     // Access-ordered, so the one dropped at the cap is the least recently drawn, not the oldest
     // loaded - a cover on screen the whole time is never the one thrown away.
     private val images = Collections.synchronizedMap(LinkedHashMap<String, ImageBitmap>(16, 0.75f, true))
@@ -172,7 +179,7 @@ internal object ArtworkCache {
         val prefix = baseUrl.sizeKey()
         val floor = wantedPixels / 2
         synchronized(images) {
-            // Scanned rather than indexed. The map holds sixty entries at most, so this is cheaper
+            // Scanned rather than indexed. The map holds a hundred and twenty entries at most, so this is cheaper
             // than maintaining a second structure - and it runs once per cover, not per frame.
             return images.entries
                 .filter { it.key.sizeKey() == prefix && it.value.width >= floor }
@@ -187,8 +194,12 @@ internal object ArtworkCache {
         synchronized(images) {
             // Oldest out, rather than everything out. Clearing wholesale threw away covers that were
             // on screen, so a long scroll made the list refetch what it was already showing.
-            if (images.size >= MAX_ENTRIES) {
-                images.keys.firstOrNull()?.let { images.remove(it) }
+            images.remove(url)
+            var total = images.values.sumOf { it.pixelBytes } + image.pixelBytes
+            val oldestFirst = images.keys.iterator()
+            while (oldestFirst.hasNext() && (images.size >= MAX_ENTRIES || total > MAX_PIXEL_BYTES)) {
+                total -= images[oldestFirst.next()]?.pixelBytes ?: 0
+                oldestFirst.remove()
             }
             images[url] = image
         }
