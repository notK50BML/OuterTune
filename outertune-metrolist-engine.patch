                 }.onFailure { if (it is CancellationException) throw it }
-                // The seek bar and lyrics line, while something is playing. Every couple of seconds
-                // rather than continuously: a widget redraw goes through the launcher, and a bar that
-                // is a second or two behind is invisible at that size. Ends with the song or the
-                // pause, since collectLatest cancels this block when either changes.
+                // The seek bar and lyrics line, while something is playing. The seek bar every couple of
+                // seconds: a widget redraw goes through the launcher, and a bar that is a second or two
+                // behind is invisible at that size. The lyrics are redrawn when the next word or line is
+                // due, and only then, so they keep time without redrawing for nothing. Ends with the
+                // song or the pause, since collectLatest cancels this block when either changes.
                 var ticks = 0
+                var lastFrame: WidgetLyrics.Frame? = null
+                var lastPushAt = android.os.SystemClock.elapsedRealtime()
                 while (playing) {
-                    // About once a second while word-timed lyrics are on a widget, so the lit words
-                    // keep up with the singing; every couple of seconds otherwise.
+                    val lyricsOn = PlayerWidget.wantsLyrics && lyricLines.isNotEmpty()
                     delay(
-                        if (PlayerWidget.wantsLyrics && WidgetLyrics.hasWords(lyricLines)) WIDGET_LYRICS_INTERVAL_MS
+                        if (lyricsOn) WidgetLyrics.nextChangeDelay(lyricLines, player.currentPosition)
                         else WIDGET_PROGRESS_INTERVAL_MS
                     )
                     if (lyricLines.isEmpty() && ++ticks % 5 == 0) lyricLines = readLyrics()
-                    PlayerWidget.setLyrics(WidgetLyrics.frameAt(lyricLines, player.currentPosition))
+                    val frame = WidgetLyrics.frameAt(lyricLines, player.currentPosition)
+                    val now = android.os.SystemClock.elapsedRealtime()
+                    if (frame == lastFrame && now - lastPushAt < WIDGET_PROGRESS_INTERVAL_MS - 100) continue
+                    lastFrame = frame
+                    lastPushAt = now
+                    PlayerWidget.setLyrics(frame)
                     runCatching { PlayerWidget.updateProgress(this@MusicService, fraction()) }
                 }
             }
@@ -2222,7 +2229,6 @@ class MusicService : MediaLibraryService(),
 
         /** How often the home-screen widget's seek bar moves while playing. */
         private const val WIDGET_PROGRESS_INTERVAL_MS = 2_000L
-        private const val WIDGET_LYRICS_INTERVAL_MS = 1_000L
 
         /**
          * How often to force-reconnect the Discord RPC socket while a song is actively playing,
