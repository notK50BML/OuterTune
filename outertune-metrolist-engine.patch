From 6a24b85124f8b9989ba08968129e2257376c2359 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sun, 25 Oct 2026 10:42:29 +0800
Subject: [PATCH 489/547] Desktop sign-in: the browser route waits for a
 session YouTube accepts

Signing in through the browser could fail with "account header missing": the flow took the
session the moment a SAPISID cookie appeared - which Google sets as soon as the password is
accepted, before the browser is sent on to music.youtube.com - and closed the browser on a session
YouTube did not honour yet. It now waits for the session to reach youtube.com, and checks it with
YouTube's account menu while the browser is still open, waiting on rather than storing one that
fails (for up to 20s, after which its own error is shown).

All three routes - browser, Firefox and cookies.txt - also keep Google's session-timestamp cookies
(__Secure-1PSIDTS, __Secure-3PSIDTS and the SIDCC set), without which newer sessions are answered
as signed out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../com/dd3boh/outertune/desktop/Account.kt   |  4 +-
 .../dd3boh/outertune/desktop/ChromeSignIn.kt  | 38 +++++++++++++++++--
 .../dd3boh/outertune/desktop/CookieImport.kt  |  8 ++++
 .../outertune/desktop/FirefoxCookies.kt       |  8 ++++
 .../outertune/desktop/ChromeSignInTest.kt     | 24 ++++++++++++
 5 files changed, 78 insertions(+), 4 deletions(-)

diff --git a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Account.kt b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Account.kt
index 1ccdddc95..a35d44394 100644
--- a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Account.kt
+++ b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Account.kt
@@ -123,7 +123,9 @@ class Account(private val db: Database) {
      * [ChromeSignIn] for why that is possible without bundling one.
      */
     suspend fun signInWithBrowser(onProgress: (ChromeSignIn.Progress) -> Unit = {}): AccountState {
-        val cookie = ChromeSignIn.signIn(onProgress = onProgress)
+        // Checked in the browser's lifetime, so a session caught before YouTube accepts it is waited
+        // on instead of stored - see ChromeSignIn.awaitSession.
+        val cookie = ChromeSignIn.signIn(onProgress = onProgress, verify = { verify(it) is AccountState.SignedIn })
             ?: return AccountState.Expired("Sign-in was not completed.").also { state.value = it }
         return signIn(cookie)
     }
