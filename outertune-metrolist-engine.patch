+fun ShuffleButton(
+    on: Boolean,
+    color: Color,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    onClick: () -> Unit,
+) {
+    ShuffleIcon(
+        on = on,
+        tint = color,
+        modifier = Modifier
