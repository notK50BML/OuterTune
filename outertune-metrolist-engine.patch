From ca696bcd282abdf095b333ddccbd62449ab0ae89 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sun, 18 Oct 2026 19:35:43 +0800
Subject: [PATCH 426/547] Desktop: a Windows installer, and a 20% smaller
 portable zip

`gradlew :desktop:installer` builds build/dist/OuterTune-setup.exe with Inno Setup 6
(packaging/OuterTune.iss): per-user (no admin prompt), Start menu and optional desktop shortcut,
an uninstaller that leaves the library in %LOCALAPPDATA% alone.

The jar is now stored rather than deflated and the runtime is jlinked without compression, so the
installer's solid LZMA2 (and the zip's deflate) compress the raw bytes instead of compressed ones:
installer 47.9MB, zip 96 -> 77MB. The cost is disk space once installed: about 226MB, from 111MB.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 desktop/build.gradle.kts        | 42 ++++++++++++++++++++++++++-
 desktop/packaging/OuterTune.iss | 50 +++++++++++++++++++++++++++++++++
 2 files changed, 91 insertions(+), 1 deletion(-)
 create mode 100644 desktop/packaging/OuterTune.iss

diff --git a/desktop/build.gradle.kts b/desktop/build.gradle.kts
index 69389b55e..a33108353 100644
--- a/desktop/build.gradle.kts
+++ b/desktop/build.gradle.kts
@@ -212,6 +212,9 @@ tasks.register<Jar>("fatJar") {
     description = "Builds a single runnable jar (java -jar outertune-desktop.jar)."
     archiveFileName.set("outertune-desktop.jar")
     manifest { attributes("Main-Class" to "com.dd3boh.outertune.desktop.MainKt") }
+    // Stored, not deflated: the zip and the installer each compress the whole app as one, and
+    // LZMA over the raw classes beats it over a jar of already-deflated entries by a wide margin.
+    entryCompression = ZipEntryCompression.STORED
     duplicatesStrategy = DuplicatesStrategy.EXCLUDE
     from(sourceSets["main"].output)
     dependsOn(configurations.runtimeClasspath)
@@ -315,7 +318,7 @@ val appImage = tasks.register<Exec>("appImage") {
             "jdk.crypto.ec", "jdk.crypto.cryptoki", "jdk.charsets", "jdk.zipfs", "jdk.accessibility",
             "jdk.localedata", "jdk.net",
         ).joinToString(","),
-        "--jlink-options", "--strip-debug --no-header-files --no-man-pages --strip-native-commands --compress=zip-6",
+        "--jlink-options", "--strip-debug --no-header-files --no-man-pages --strip-native-commands --compress=zip-0",
         "--java-options", "-Xmx320m -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m",
     )
 }
@@ -329,6 +332,43 @@ tasks.register<Zip>("packageApp") {
     destinationDirectory.set(layout.buildDirectory.dir("dist"))
 }
 
+/**
+ * `gradlew :desktop:installer` - build/dist/OuterTune-setup.exe: the same app image as packageApp,
+ * as an Inno Setup installer (packaging/OuterTune.iss) with Start menu and desktop shortcuts and an
+ * uninstaller. Per-user, so no administrator prompt.
+ *
+ * Needs Inno Setup 6 on the build machine (`winget install JRSoftware.InnoSetup`); its compiler is
+ * looked for where winget and the official installer put it, or wherever -PisccPath= says.
+ */
+tasks.register<Exec>("installer") {
+    group = "distribution"
+    description = "Builds the Windows installer (build/dist/OuterTune-setup.exe). Needs Inno Setup 6."
+    dependsOn(appImage)
+    val script = layout.projectDirectory.file("packaging/OuterTune.iss").asFile
+    val source = appImageOut.get().asFile.resolve("OuterTune")
+    val out = layout.buildDirectory.dir("dist").get().asFile
+    val icon = appIcon.asFile
+    inputs.file(script)
+    inputs.dir(appImageOut)
+    outputs.file(out.resolve("OuterTune-setup.exe"))
+    val iscc = (findProperty("isccPath") as String?)
+        ?: listOfNotNull(
+            System.getenv("LOCALAPPDATA")?.let { "$it\\Programs\\Inno Setup 6\\ISCC.exe" },
+            "C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe",
+            "C:\\Program Files\\Inno Setup 6\\ISCC.exe",
+        ).firstOrNull { File(it).exists() }
+        ?: "ISCC.exe"
+    executable(iscc)
+    args(
+        "/Q",
+        "/DSourceDir=${source.absolutePath}",
+        "/DOutDir=${out.absolutePath}",
+        "/DIconFile=${icon.absolutePath}",
+        "/DAppVersion=0.10.15",
+        script.absolutePath,
+    )
+}
+
 // The player layout editor ships inside the app (Settings > Player > Player layout > Open editor).
 tasks.named<ProcessResources>("processResources") {
     from(rootProject.file("tools/layout-editor.html")) { into("editor") }
diff --git a/desktop/packaging/OuterTune.iss b/desktop/packaging/OuterTune.iss
new file mode 100644
index 000000000..09126c6fe
--- /dev/null
+++ b/desktop/packaging/OuterTune.iss
@@ -0,0 +1,50 @@
+; OuterTune's Windows installer. Built by `gradlew :desktop:installer`, which passes:
+;   SourceDir  - the jpackage app image (OuterTune.exe, app\, runtime\)
+;   OutDir     - where OuterTune-setup.exe goes
+;   AppVersion - the app's version
+;   IconFile   - packaging\OuterTune.ico
+;
+; Per-user by default, so installing needs no administrator prompt; the user can choose all users.
+; One solid LZMA2 block over everything is where the size saving over the zip comes from.
+
+#ifndef AppVersion
+  #define AppVersion "0.0.0"
+#endif
+
+[Setup]
+AppId={{6B0E7D52-3C1F-4C8E-9C61-0F7A3E5B2D41}
+AppName=OuterTune
+AppVersion={#AppVersion}
+AppPublisher=OuterTune Project
+AppPublisherURL=https://github.com/notK50BML/OuterTune
+DefaultDirName={autopf}\OuterTune
+DefaultGroupName=OuterTune
+DisableProgramGroupPage=yes
+PrivilegesRequired=lowest
+PrivilegesRequiredOverridesAllowed=dialog
+ArchitecturesAllowed=x64compatible
+ArchitecturesInstallIn64BitMode=x64compatible
+OutputDir={#OutDir}
+OutputBaseFilename=OuterTune-setup
+SetupIconFile={#IconFile}
+UninstallDisplayIcon={app}\OuterTune.exe
+Compression=lzma2/ultra64
+SolidCompression=yes
+LZMANumBlockThreads=4
+WizardStyle=modern
+; The library, settings and downloads live in the user's profile, not here, so uninstalling the app
+; never touches them.
+CloseApplications=yes
+
+[Tasks]
+Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
+
+[Files]
+Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
+
+[Icons]
+Name: "{autoprograms}\OuterTune"; Filename: "{app}\OuterTune.exe"
+Name: "{autodesktop}\OuterTune"; Filename: "{app}\OuterTune.exe"; Tasks: desktopicon
+
+[Run]
+Filename: "{app}\OuterTune.exe"; Description: "{cm:LaunchProgram,OuterTune}"; Flags: nowait postinstall skipifsilent
-- 
2.45.1.windows.1


From a1529407f292ee2ca316edf7d73272a73a15b4da Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sun, 18 Oct 2026 19:36:12 +0800
Subject: [PATCH 427/547] Add a handoff note: where things stand and what is
 next

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 HANDOFF.md | 88 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 HANDOFF.md

diff --git a/HANDOFF.md b/HANDOFF.md
new file mode 100644
index 000000000..eb6d75911
--- /dev/null
+++ b/HANDOFF.md
@@ -0,0 +1,88 @@
+# Handoff: where we left off (18 Oct 2026)
+
+Branch `metrolist-engine` in the worktree `C:\Outertune-Claude\live`. Remote:
+https://github.com/notK50BML/OuterTune.git. All work is committed and pushed. The patch
+`outertune-metrolist-engine.patch` is regenerated after each change.
+
+## Builds
+
+| What | Command | Output |
+|---|---|---|
+| Windows installer | `gradlew :desktop:installer` | `desktop/build/dist/OuterTune-setup.exe` (47.9MB) |
+| Windows portable zip | `gradlew :desktop:packageApp` | `desktop/build/dist/OuterTune-windows.zip` (77MB) |
+| Android debug APKs | `gradlew :app:assembleFullDebug` | `app/build/outputs/apk/full/debug/` |
+| Desktop tests | `gradlew :desktop:test` | all passing |
+
+- **JDK:** builds need JDK 21: `export JAVA_HOME="/c/Program Files/Java/jdk-21.0.11"`.
+- **Inno Setup:** the installer needs Inno Setup 6. It is installed per-user, via winget, at
+  `%LOCALAPPDATA%\Programs\Inno Setup 6`. On another machine, run
+  `winget install JRSoftware.InnoSetup`, or pass `-PisccPath=`.
+- **Regenerating the patch:** after each commit run
+  `git format-patch --stdout --base=93260340a4f9d8d275485b7784d317b875cb7d71 93260340a4f9d8d275485b7784d317b875cb7d71..HEAD -- . ':!outertune-metrolist-engine.patch' > outertune-metrolist-engine.patch`,
+  then commit it as "Regenerate the patch".
+
+## Done in this stretch
+
+### Layout editor (`tools/layout-editor.html`)
+- **Exact match:** the phone preview is built from a dp model of `Player.kt`. On a 1080x2400 /
+  420dpi emulator, the Guided default and the Free layout seeded from it land within 1px of the
+  built-in player.
+- **Renames and defaults:** "Stacked" is now "Guided", and the default preset is the built-in player.
+- **New controls:** a density (dpi) field.
+- **Player buttons:** the stand-ins are like, download, equaliser and ⋮.
+
+### Android
+- **Imported layouts:** they honour side padding, cover size, radius and hiding, and title
+  alignment. Free blocks are centred on their x/y.
+- **Bug fixes:** the progress times no longer overlap the bar, and the separated transport row
+  keeps play's 8dp gaps.
+- **Debug-only hook:** `adb shell am start ... --es ot_layout_b64 <base64 json>` sets a layout.
+  This is how the emulator checks were done; see `MainActivity`.
+- **Player buttons:** "Add to queue" is no longer offered beside the player's ⋮. It is still in
+  the menu.
+
+### Windows
+- **Song rows:** a ⋮ on every song row opens an animated, rounded panel of tiles. Right-click opens
+  the same panel. Settings > Appearance > Song rows picks the quick buttons, and can hide the ⋮.
+- **Player ⋮:** it opens the same panel (`MenuPanel` in `SongMenuPanel.kt`). The panel flips above
+  its button when it is low in the window.
+- **Settings:** the sections follow the phone's sections, names and order.
+- **Search:** the suggestions have their own open state, so clicking inside them, or the ✕, no
+  longer closes them.
+- **Downloads:** a downloaded song, playlist or album shows the phone's downloaded icon
+  (OfflinePin). Clicking it removes the download; for a list, every song in it.
+- **Installer:** see Builds above.
+- **Earlier:**
+  - playlist and album "Download all"
+  - saved queues (up to 19)
+  - ferrofluid reactivity setting
+  - full player as an overlay, so settings and scroll positions survive closing it
+  - the layout editor bundled into both apps
+
+## Open / next
+
+- **Installer, disk size:** the installed size is 226MB, up from 111MB. That is the price of the
+  small download: the jar is stored rather than deflated, and the runtime is jlinked with
