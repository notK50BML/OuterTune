+                    """<span begin="00:30.000" end="00:30.400">hey</span>""" +
+                    """<span ttm:role="x-bg" begin="00:30.200" end="00:31.000">""" +
+                    """<span begin="00:30.200" end="00:31.000">(ooh)</span></span></p>"""
