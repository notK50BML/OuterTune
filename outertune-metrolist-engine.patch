+        <button data-preset="airy">Airy</button>
+        <button data-preset="cinema">Cinema</button>
+        <button data-preset="dense">Everything</button>
         <button data-preset="freeStart">Free: start from stacked</button>
       </div>
     </div>
@@ -392,15 +395,28 @@ function actionMembers(scale, visible = true) {
   return ACTION_MEMBERS.map(id => ({ id, visible, scale, group: "actions" }));
 }
 
+/*
+ * Presets.
+ *
+ * The action cluster - sleep timer, like, equalizer, overflow - sits directly after the title in
+ * every one of these, because that is where the app puts it. Player.kt's own comment on the call
+ * site reads "action buttons for portrait (inline with title)". The editor used to place it in a
+ * strip below the transport row, which is not a layout the app ever draws, and made the preset look
+ * like a settings screen rather than a player.
+ *
+ * Shapes borrowed from players that have already answered these questions: Spotify keeps a small
+ * cover high with the transport low and a lot of air between; Apple Music leans on a very large
+ * cover with tight controls beneath it; Poweramp is the dense end, everything visible at once.
+ */
 const PRESETS = {
   default: {
     mode: "stack", spacing: 16, sidePadding: 24,
     blocks: [
       { id: "artwork", visible: true, size: 100, radius: 12 },
       { id: "info", visible: true, scale: 100, align: "start" },
+      ...actionMembers(100),
       { id: "progress", visible: true, scale: 100 },
       ...controlMembers(100),
-      ...actionMembers(100),
       { id: "queue", visible: true },
     ],
   },
@@ -409,9 +425,9 @@ const PRESETS = {
     blocks: [
       { id: "artwork", visible: true, size: 72, radius: 20 },
       { id: "info", visible: true, scale: 90, align: "center" },
+      ...actionMembers(85),
       { id: "progress", visible: true, scale: 100 },
       ...controlMembers(95),
-      ...actionMembers(85),
       { id: "queue", visible: true },
     ],
   },
@@ -420,8 +436,8 @@ const PRESETS = {
     blocks: [
       { id: "artwork", visible: true, size: 118, radius: 0 },
       { id: "info", visible: true, scale: 105, align: "center" },
-      ...controlMembers(110),
       { id: "progress", visible: true, scale: 100 },
+      ...controlMembers(110),
       ...actionMembers(100, false),
       { id: "queue", visible: true },
     ],
@@ -431,12 +447,52 @@ const PRESETS = {
     blocks: [
       { id: "artwork", visible: true, size: 88, radius: 999 },
       { id: "info", visible: true, scale: 100, align: "center" },
-      ...controlMembers(100),
-      { id: "progress", visible: false, scale: 100 },
       ...actionMembers(100, false),
+      { id: "progress", visible: false, scale: 100 },
+      ...controlMembers(100),
+      { id: "queue", visible: false },
+    ],
