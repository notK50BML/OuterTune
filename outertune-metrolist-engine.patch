From c1fde46bd534e508569b0c3593a77e0f7b629179 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sat, 17 Oct 2026 12:28:14 +0800
Subject: [PATCH 369/547] Speed up CI release builds without touching
 minification

- setup-gradle caches dependencies and the Gradle build cache between
  runs (setup-java's cache stays off; it tripped over this repo's
  history). Unchanged modules - media3 above all - are restored rather
  than recompiled.
- org.gradle.parallel and org.gradle.caching on; Gradle heap 6GB so R8
  is not starved on the 16GB runners.
- Release variants skip lintVital, the lint pass assemble runs implicitly
  and the workflow already meant to skip. R8 minify and resource
  shrinking are unaffected - only lint-only tasks leave the graph.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/build-new-patched.yml     | 20 ++++++++++++++++++++
 .github/workflows/build-patched-backlog.yml | 20 ++++++++++++++++++++
 .github/workflows/build-patched.yml         | 20 ++++++++++++++++++++
 gradle.properties                           | 10 +++++++++-
 4 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/build-new-patched.yml b/.github/workflows/build-new-patched.yml
index fe1ce700d..c2e8d54a7 100644
--- a/.github/workflows/build-new-patched.yml
+++ b/.github/workflows/build-new-patched.yml
@@ -284,6 +284,17 @@ jobs:
           # a speed nicety, not a correctness requirement, so it's simplest to just not depend on
           # that code path at all rather than chase a transient runner-side glitch.
 
+      # Caches Gradle's downloads and its build cache between runs - the largest single cost of a
+      # cold build here, since media3 is compiled from source as an included build. setup-gradle
+      # rather than setup-java's own cache, which tripped over this repo's history (see above).
+      # Written from any branch, not just the default one, since builds are dispatched from several.
+      # Nothing about the output changes: R8 still minifies and shrinks, and a cached task is only
+      # reused when its inputs are byte-for-byte identical.
+      - name: Set up Gradle (with caching)
+        uses: gradle/actions/setup-gradle@v4
+        with:
+          cache-read-only: false
+
       - name: Accept Android SDK licenses
         run: yes | /usr/local/lib/android/sdk/cmdline-tools/latest/bin/sdkmanager --licenses
 
@@ -342,6 +353,15 @@ jobs:
             echo "::notice::Keeping only these languages: ${{ inputs.locales }} (plus English)"
           fi
 
+          # lintVital is the lint pass Android Gradle runs inside every release assemble. This
+          # workflow skips lint on purpose (see above), and that one pass is a couple of minutes of
+          # analysing all fifty locales. Release only: debug and userdebug do not run it at all, and
+          # -x on a task that does not exist fails the build.
+          VARIANT="${{ inputs.variant }}"
+          case "$VARIANT" in
+            *Release) GRADLE_ARGS="$GRADLE_ARGS -x lintVital${VARIANT^}" ;;
+          esac
+
           ./gradlew assemble${{ inputs.variant }} $GRADLE_ARGS --stacktrace -DskipFormatKtlint 2>&1 | tee build.log
 
       # Gradle prints compiler errors early and then buries them under a stack trace hundreds of
