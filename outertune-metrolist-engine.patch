+                    topLeft = Offset(x, size.height - h),
+                    size = androidx.compose.ui.geometry.Size(w * 0.85f, h),
+                )
+            }
+        }
+
         // The zero line, so a flat response is visibly flat rather than merely central.
         drawLine(
             color = onColour.copy(alpha = 0.25f),
