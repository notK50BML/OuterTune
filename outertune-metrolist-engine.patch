 .../java/com/dd3boh/outertune/ui/menu/SongMenu.kt   |  8 ++++++--
 .../outertune/utils/scanners/LocalMediaScanner.kt   |  3 +++
 3 files changed, 22 insertions(+), 2 deletions(-)

