+      // 52px play button inside a block the layout had decided was 40px wide simply spilled over
+      // its neighbours. Buttons are content-sized and centred; only the full-width blocks - cover,
+      // title, progress, queue - take a width from the layout.
+      if (isButton(b.id)) {
+        node.style.width = "auto";
+      } else {
+        node.style.width = w + "%";
+        if (b.id === "artwork") node.style.height = blockHeightPct(b, scr) + "%";
+      }
+      node.innerHTML = blockMarkup(b, boxW * w / 100);
+      node.appendChild(Object.assign(document.createElement("div"), { className: "handle" }));
+      attachDrag(node, b, boxW, boxH);
+      surface.appendChild(node);
+    }
+  }
+
+  document.getElementById("stageNote").textContent =
+    previewAspect
+      ? "Checking on " + previewAspect.label + " — your design is still " + screen.width + "x" + screen.height
+      : "Previewing your screen, " + screen.width + "x" + screen.height;
+}
+
+function handleBlockClick(e, id) {
+  if (e.shiftKey) {
+    if (multiSelected.has(id)) multiSelected.delete(id); else multiSelected.add(id);
+    render();
+  } else {
+    select(id);
+  }
+}
+
+function attachDrag(node, block, boxW, boxH) {
+  let mode = null, sx = 0, sy = 0, ow = 0;
+  let moving = [];
+
+  node.addEventListener("pointerdown", e => {
+    mode = e.target.classList.contains("handle") ? "resize" : "move";
+    sx = e.clientX; sy = e.clientY;
+    ow = get(block, "w");
+    moving = mode === "move" && block.group
+      ? membersOf(block.group).map(b => ({ block: b, ox: get(b, "x"), oy: get(b, "y") }))
+      : [{ block, ox: get(block, "x"), oy: get(block, "y") }];
+    if (!e.shiftKey) setSelected(block.id);
+    node.setPointerCapture(e.pointerId);
+    e.preventDefault();
+  });
+
+  node.addEventListener("pointermove", e => {
+    if (!mode) return;
+    const snap = !e.shiftKey;
+    const dxPct = ((e.clientX - sx) / boxW) * 100;
+    const dyPct = ((e.clientY - sy) / boxH) * 100;
+
+    if (mode === "move") {
+      let onCentre = false;
+      for (const m of moving) {
+        let x = m.ox + dxPct;
+        let y = m.oy + dyPct;
+        if (snap) {
+          if (m.block === block && Math.abs(x - 50) < 1.6) { x = 50; onCentre = true; }
+          else if (m.block === block) x = Math.round(x * 2) / 2;
+          y = Math.round(y * 2) / 2;
+        }
+        m.block.x = round1(clamp(x, 0, 100));
+        m.block.y = round1(clamp(y, 0, 100));
+        const n = document.querySelector(`#surface .blk[data-id="${m.block.id}"]`);
+        if (n) { n.style.left = m.block.x + "%"; n.style.top = m.block.y + "%"; }
+      }
+      node.classList.toggle("snapped", onCentre);
+    } else {
+      let w = ow + dxPct * 2;
+      if (snap) w = Math.round(w * 2) / 2;
+      block.w = round1(clamp(w, 8, 100));
+      node.style.width = block.w + "%";
+      if (block.id === "artwork") node.style.height = blockHeightPct(block, activeScreen()) + "%";
+    }
+    queueJson();
+  });
+
+  const end = e => {
+    if (!mode) return;
+    mode = null;
+    node.classList.remove("snapped");
+    try { node.releasePointerCapture(e.pointerId); } catch (_) {}
+    renderList();
+    syncJson();
+  };
+  node.addEventListener("pointerup", end);
+  node.addEventListener("pointercancel", end);
+}
+
+function renderGroupBar() {
+  const bar = document.getElementById("groupbar");
+  bar.innerHTML = "";
+  if (multiSelected.size < 2) return;
+  const wrap = document.createElement("div");
+  wrap.className = "groupbar";
+  wrap.innerHTML = `<span><strong>${multiSelected.size} selected</strong> — group them so they move and hide together.</span>`;
+  const btns = document.createElement("div");
+  btns.className = "btns";
+  const g = document.createElement("button");
+  g.className = "primary";
+  g.textContent = "Group";
+  g.onclick = groupSelected;
+  const c = document.createElement("button");
+  c.textContent = "Clear selection";
+  c.onclick = () => { multiSelected.clear(); render(); };
+  btns.append(g, c);
+  wrap.appendChild(btns);
+  bar.appendChild(wrap);
+}
+
+function renderList() {
+  renderGroupBar();
+  const list = document.getElementById("list");
+  list.innerHTML = "";
+  const stacked = state.mode === "stack";
+
+  state.blocks.forEach((b, index) => {
+    const def = defOf(b.id);
+    if (!def) return;
+
+    const row = document.createElement("div");
+    row.className = "row" + (selected === b.id ? " sel" : "") + (multiSelected.has(b.id) ? " multisel" : "");
+    row.draggable = stacked;
+    row.dataset.index = index;
+    if (b.group) row.style.borderLeftColor = groupColor(b.group);
+
+    const grip = document.createElement("span");
+    grip.className = "grip" + (stacked ? "" : " off");
+    grip.textContent = "≡";
+    grip.title = stacked ? "Drag to reorder" : "Order does not apply in free placement";
+    row.appendChild(grip);
+
+    const cb = document.createElement("input");
+    cb.type = "checkbox";
+    cb.checked = b.visible;
+    cb.title = def.locked ? "Always shown - the player needs a way to pause" : "Visible";
+    cb.disabled = !!def.locked;
+    cb.onchange = () => { b.visible = cb.checked; render(); };
+    row.appendChild(cb);
+
+    if (b.group) {
+      const dot = document.createElement("span");
+      dot.className = "grpdot";
+      dot.style.background = groupColor(b.group);
+      dot.title = "Grouped with " + membersOf(b.group).length + " other block(s)";
+      row.appendChild(dot);
+    }
+
+    const name = document.createElement("span");
+    name.className = "name";
+    name.textContent = def.label;
+    name.onclick = e => handleBlockClick(e, b.id);
+    row.appendChild(name);
+
+    if (b.group) {
+      const ug = document.createElement("button");
+      ug.textContent = "Ungroup";
+      ug.title = "Free every block in this cluster to move independently";
+      ug.onclick = e => { e.stopPropagation(); ungroup(b.group); };
+      row.appendChild(ug);
+    }
+
+    if (stacked) {
+      row.addEventListener("dragstart", e => {
+        row.classList.add("dragging");
+        e.dataTransfer.setData("text/plain", String(index));
+        e.dataTransfer.effectAllowed = "move";
+      });
+      row.addEventListener("dragend", () => {
+        row.classList.remove("dragging");
+        document.querySelectorAll(".row.over").forEach(r => r.classList.remove("over"));
+      });
+      row.addEventListener("dragover", e => { e.preventDefault(); row.classList.add("over"); });
+      row.addEventListener("dragleave", () => row.classList.remove("over"));
+      row.addEventListener("drop", e => {
+        e.preventDefault();
+        row.classList.remove("over");
+        const from = parseInt(e.dataTransfer.getData("text/plain"), 10);
+        if (Number.isNaN(from) || from === index) return;
+        const [moved] = state.blocks.splice(from, 1);
+        state.blocks.splice(index, 0, moved);
+        render();
+      });
+    }
+
+    list.appendChild(row);
+
+    const knobs = document.createElement("div");
+    knobs.className = "knobs" + (selected === b.id ? " open" : "");
+    if (stacked && def.knobs.includes("size")) knobs.appendChild(slider(b, "size", "Size", 40, 130, "%"));
+    if (def.knobs.includes("rot")) knobs.appendChild(slider(b, "rot", "Rotation", -45, 45, "°"));
+    if (def.knobs.includes("radius")) knobs.appendChild(slider(b, "radius", "Corners", 0, 160, "dp"));
+    if (def.knobs.includes("scale")) knobs.appendChild(slider(b, "scale", "Scale", 70, 130, "%"));
+    if (def.knobs.includes("align")) knobs.appendChild(alignPicker(b));
+    if (!stacked) {
+      knobs.appendChild(slider(b, "x", "Horizontal", 0, 100, "%"));
+      knobs.appendChild(slider(b, "y", "Vertical", 0, 100, "%"));
+      // Not offered for buttons: they are content-sized in free mode, so a width slider would be
+      // a control that visibly does nothing. Their size comes from Scale.
+      if (!isButton(b.id)) {
+        knobs.appendChild(slider(b, "w", b.id === "artwork" ? "Size" : "Width", 8, 100, "%"));
+      }
+    }
+    if (knobs.children.length) list.appendChild(knobs);
+  });
+
+  document.getElementById("listNote").innerHTML = stacked
+    ? "Order here is the order down the screen — a grouped cluster renders together wherever its " +
+      "<strong>first</strong> member sits. Hidden blocks stay listed so you can bring them back."
+    : "Drag blocks in the preview, or use the sliders. The <strong>square handle</strong> resizes. " +
+      "Blocks are positioned by their <strong>centre</strong>, so Horizontal slides them across " +
+      "the screen and resizing grows them both ways. Dragging a grouped block moves its whole " +
+      "cluster together. They snap to the middle and to half a percent — hold <strong>Shift</strong> " +
+      "for fine control (or to multi-select instead of dragging).";
+}
+
+function slider(block, key, label, min, max, unit) {
+  const wrap = document.createElement("div");
+  wrap.className = "knob";
+  const l = document.createElement("label");
+  l.textContent = label;
+  const input = document.createElement("input");
+  input.type = "range";
+  input.min = min; input.max = max; input.step = 1;
+  input.value = get(block, key);
+  const out = document.createElement("output");
+  out.textContent = get(block, key) + unit;
+  input.oninput = () => {
+    block[key] = parseInt(input.value, 10);
+    if (key === "x" || key === "y") block[key] = clamp(block[key], 0, 100);
+    if (key === "w") block[key] = clamp(block[key], 8, 100);
+    out.textContent = block[key] + unit;
+    renderPreview();
+    syncJson();
+  };
+  wrap.append(l, input, out);
+  return wrap;
+}
+
+function alignPicker(block) {
+  const wrap = document.createElement("div");
+  wrap.className = "knob";
+  const l = document.createElement("label");
+  l.textContent = "Align";
+  const sel = document.createElement("select");
+  for (const v of ["start", "center"]) {
+    const o = document.createElement("option");
+    o.value = v; o.textContent = v === "start" ? "Left" : "Centre";
+    if (get(block, "align") === v) o.selected = true;
+    sel.appendChild(o);
+  }
+  sel.onchange = () => { block.align = sel.value; render(); };
+  wrap.append(l, sel, document.createElement("output"));
+  return wrap;
+}
+
+function select(id, keepOpen) {
+  selected = (!keepOpen && selected === id) ? null : id;
+  multiSelected.clear();
+  render();
+}
+
+function setSelected(id) {
+  selected = id;
+  multiSelected.clear();
+  document.querySelectorAll("#surface .blk").forEach(n => {
+    const owns = n.dataset.id === id || (n.dataset.group && n.dataset.group === groupOf(id));
+    n.classList.toggle("sel", owns);
+  });
+  renderList();
+}
+
+let jsonFrame = 0;
+function queueJson() {
+  if (jsonFrame) return;
+  jsonFrame = requestAnimationFrame(() => { jsonFrame = 0; syncJson(); });
+}
+
+function toJson() {
+  const free = state.mode === "free";
+  return {
+    schemaVersion: SCHEMA_VERSION,
+    orientation: "portrait",
+    mode: state.mode,
+    anchor: "center",
+    designedFor: { width: screen.width, height: screen.height },
+    spacing: state.spacing,
+    sidePadding: state.sidePadding,
+    blocks: state.blocks.map(b => {
+      const def = defOf(b.id);
+      const out = { id: b.id, visible: !!b.visible };
+      if (b.group) out.group = b.group;
+      if (def.knobs.includes("radius")) out.radius = get(b, "radius");
+      if (def.knobs.includes("scale")) out.scale = get(b, "scale");
+      if (def.knobs.includes("align")) out.align = get(b, "align");
+      if (def.knobs.includes("rot")) out.rot = get(b, "rot");
+      if (free) {
+        out.x = get(b, "x"); out.y = get(b, "y"); out.w = get(b, "w");
+      } else if (def.knobs.includes("size")) {
+        out.size = get(b, "size");
+      }
+      return out;
+    }),
+  };
+}
+
+function syncJson() {
+  document.getElementById("json").value = JSON.stringify(toJson(), null, 2);
+}
+
+function importJson(text) {
+  let parsed;
+  try { parsed = JSON.parse(text); } catch (e) { return "That is not valid JSON."; }
+  if (!parsed || !Array.isArray(parsed.blocks)) return "No blocks found in that file.";
+  if (parsed.schemaVersion > SCHEMA_VERSION) return "That file is from a newer editor (v" + parsed.schemaVersion + ").";
+
+  const incoming = expandLegacy(parsed.blocks.map(clone));
+  const seen = new Set();
+  const blocks = [];
+  for (const b of incoming) {
+    if (defOf(b.id) && !seen.has(b.id)) { seen.add(b.id); blocks.push(b); }
+  }
+  for (const def of BLOCK_DEFS) {
+    if (!seen.has(def.id)) blocks.push({ id: def.id, visible: true });
+  }
+
+  state = {
+    mode: parsed.mode === "free" ? "free" : "stack",
+    spacing: clampNum(parsed.spacing, 0, 40, 16),
+    sidePadding: clampNum(parsed.sidePadding, 0, 48, 24),
+    blocks,
+  };
+  if (parsed.designedFor) {
+    screen = {
+      width: clampNum(parsed.designedFor.width, 240, 4000, 1080),
+      height: clampNum(parsed.designedFor.height, 320, 6000, 2400),
+    };
+  }
+  if (state.mode === "free") seedFreePositions();
+  selected = null;
+  multiSelected.clear();
+  previewAspect = null;
+  render();
+  return null;
+}
+
+function clampNum(v, min, max, fallback) {
+  const n = Number(v);
+  if (!Number.isFinite(n)) return fallback;
+  return clamp(Math.round(n), min, max);
+}
+
+function toast(msg, bad) {
+  const t = document.getElementById("toast");
+  t.textContent = msg;
+  t.style.color = bad ? "var(--accent)" : "var(--ok)";
+  setTimeout(() => { if (t.textContent === msg) t.textContent = ""; }, 3200);
+}
+
+function render() {
+  renderList();
+  renderPreview();
+  renderAspects();
+  syncControls();
+  syncJson();
+}
+
+function renderAspects() {
+  const wrap = document.getElementById("aspects");
+  wrap.innerHTML = "";
+  const mine = document.createElement("button");
+  mine.textContent = "My screen";
+  mine.className = previewAspect ? "" : "on";
+  mine.onclick = () => { previewAspect = null; render(); };
+  wrap.appendChild(mine);
+  for (const a of ASPECTS) {
+    const btn = document.createElement("button");
+    btn.textContent = a.label;
+    btn.className = previewAspect && previewAspect.label === a.label ? "on" : "";
+    btn.onclick = () => { previewAspect = a; render(); };
+    wrap.appendChild(btn);
+  }
+}
+
+function syncControls() {
+  document.getElementById("sw").value = screen.width;
+  document.getElementById("sh").value = screen.height;
+  document.getElementById("gap").value = state.spacing;
+  document.getElementById("pad").value = state.sidePadding;
+  document.getElementById("gapOut").textContent = state.spacing + "dp";
+  document.getElementById("padOut").textContent = state.sidePadding + "dp";
+  document.getElementById("globalCard").style.display = state.mode === "stack" ? "" : "none";
+  document.querySelectorAll("[data-mode]").forEach(b => {
+    b.className = b.dataset.mode === state.mode ? "on" : "";
+  });
+  document.getElementById("modeNote").innerHTML = state.mode === "stack"
+    ? "<strong>Stacked</strong> is the safe default: blocks sit in a column, so nothing overlaps and nothing can end up off-screen whatever the phone."
+    : "<strong>Free placement</strong> stores positions as percentages of the screen, so it scales with size — but a phone of a different <em>shape</em> will stretch it. Check the other ratios below the preview before exporting.";
+}
+
+document.getElementById("sw").oninput = e => {
+  screen.width = clampNum(e.target.value, 240, 4000, 1080);
+  renderPreview(); syncJson();
+};
+document.getElementById("sh").oninput = e => {
+  screen.height = clampNum(e.target.value, 320, 6000, 2400);
+  renderPreview(); syncJson();
+};
+document.getElementById("gap").oninput = e => {
+  state.spacing = parseInt(e.target.value, 10);
+  document.getElementById("gapOut").textContent = state.spacing + "dp";
+  renderPreview(); syncJson();
+};
+document.getElementById("pad").oninput = e => {
+  state.sidePadding = parseInt(e.target.value, 10);
+  document.getElementById("padOut").textContent = state.sidePadding + "dp";
+  renderPreview(); syncJson();
+};
+
+document.querySelectorAll("[data-mode]").forEach(btn => {
+  btn.onclick = () => {
+    state.mode = btn.dataset.mode;
+    if (state.mode === "free") seedFreePositions();
+    selected = null;
+    multiSelected.clear();
+    render();
+  };
+});
+
+document.querySelectorAll("[data-preset]").forEach(btn => {
+  btn.onclick = () => {
+    const key = btn.dataset.preset;
+    if (key === "freeStart") {
+      state.mode = "free";
+      state.blocks.forEach(b => { delete b.x; delete b.y; delete b.w; });
+      seedFreePositions();
+      toast("Froze the stacked layout into free placement.");
+    } else {
+      state = materialize(clone(PRESETS[key]));
+      toast("Loaded the " + btn.textContent.toLowerCase() + " preset.");
+    }
+    selected = null;
+    multiSelected.clear();
+    render();
+  };
+});
+
+document.getElementById("download").onclick = () => {
+  const blob = new Blob([JSON.stringify(toJson(), null, 2)], { type: "application/json" });
+  const a = document.createElement("a");
+  a.href = URL.createObjectURL(blob);
+  a.download = "player-layout.json";
+  a.click();
+  URL.revokeObjectURL(a.href);
+  toast("Saved player-layout.json");
+};
+
+document.getElementById("copy").onclick = async () => {
+  const text = JSON.stringify(toJson(), null, 2);
+  try {
+    await navigator.clipboard.writeText(text);
+    toast("Copied to the clipboard.");
+  } catch (e) {
+    document.getElementById("json").select();
+    toast("Selected it for you — press Ctrl+C.", true);
+  }
+};
+
+document.getElementById("paste").onclick = () => {
+  const err = importJson(document.getElementById("json").value);
+  toast(err || "Imported.", !!err);
+};
+
+render();
+</script>
+</body>
+</html>
-- 
