+        Pcm.readSample(bytes, 0, bytesPerSample = 2, bigEndian = true).toInt()
+
+    private fun readRight(bytes: ByteArray) =
+        Pcm.readSample(bytes, 2, bytesPerSample = 2, bigEndian = true).toInt()
