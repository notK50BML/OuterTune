+/**
+ * Whether [child] is [parent] or a folder inside it, compared as folders rather than as text.
+ *
+ * The scan-folder check used to be `child.toString().contains(parent.toString())`. That reads a
+ * prefix of the characters, so two unrelated folders can overlap ("Music" and "Music Videos"), and
+ * anything that shares a short stored value with a download path - a path saved as just the storage
+ * root, say - made every folder outside the download folder come up red. Tree document ids are
+ * "volume:relative/path"; one folder is inside another when it is the same volume and the path is
+ * the same or continues past a "/".
+ */
+fun uriIsWithin(child: Uri, parent: Uri): Boolean {
+    if (child == parent) return true
+    if (child.authority != parent.authority) return false
+    val a = runCatching { DocumentsContract.getTreeDocumentId(child) }.getOrNull() ?: return false
+    val b = runCatching { DocumentsContract.getTreeDocumentId(parent) }.getOrNull() ?: return false
+    if (a == b) return true
+    val volume = b.substringBefore(':', "")
+    if (a.substringBefore(':', "") != volume) return false
+    val path = b.substringAfter(':', "").trimEnd('/')
+    // A path of nothing is the whole volume, which holds everything on it.
+    return path.isEmpty() || a.substringAfter(':', "").let { it == path || it.startsWith("$path/") }
+}
