From 094058e850bc6ce4da7667106af5e7cf02c4b54b Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Mon, 26 Oct 2026 19:04:26 +0800
Subject: [PATCH 525/547] Desktop: fix the crash a few seconds after start

The cover cache's new size limit read covers by key while walking the
map. The map is access-ordered, so each read moved an entry under the
walk's own iterator and threw - an "unknown error" once enough covers
had loaded, playing or not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
index 3533ec661..df25e1080 100644
--- a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
+++ b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Artwork.kt
@@ -196,9 +196,11 @@ internal object ArtworkCache {
             // on screen, so a long scroll made the list refetch what it was already showing.
             images.remove(url)
             var total = images.values.sumOf { it.pixelBytes } + image.pixelBytes
-            val oldestFirst = images.keys.iterator()
+            // Through the entries, never images[key]: the map is access-ordered, so a get moves the
+            // entry to the end - a change to the map under its own iterator, which threw.
+            val oldestFirst = images.entries.iterator()
             while (oldestFirst.hasNext() && (images.size >= MAX_ENTRIES || total > MAX_PIXEL_BYTES)) {
-                total -= images[oldestFirst.next()]?.pixelBytes ?: 0
+                total -= oldestFirst.next().value.pixelBytes
                 oldestFirst.remove()
             }
             images[url] = image
-- 
