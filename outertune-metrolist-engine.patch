+        // exactly the lines that matter and leaves a file that appears to have parsed fine.
+        val text = file(
+            line(".youtube.com", "SAPISID", "abc123", httpOnly = true),
+            line(".youtube.com", "__Secure-3PSID", "secure", httpOnly = true),
+        )
