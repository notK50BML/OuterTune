+/**
+ * Android 12+ does not let an app make itself the default for web links; only the user can, in the
+ * system's "Open by default" page. This goes straight to that page for this app (falling back to
+ * the app's info page), where "Add link" / "Open supported links" can be switched on.
+ */
+private fun openLinkDefaults(context: android.content.Context) {
+    val pkg = android.net.Uri.parse("package:${context.packageName}")
+    val intents = buildList {
+        if (android.os.Build.VERSION.SDK_INT >= 31) {
+            add(android.content.Intent(android.provider.Settings.ACTION_APP_OPEN_BY_DEFAULT_SETTINGS, pkg))
+        }
+        add(android.content.Intent(android.provider.Settings.ACTION_APPLICATION_DETAILS_SETTINGS, pkg))
+    }
+    for (intent in intents) {
+        if (runCatching { context.startActivity(intent.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)) }.isSuccess) return
+    }
+}
