+
+/**
+ * The buttons that can sit on the top of Home and in the search field. One set serves both places,
+ * and the user picks which are shown and in what order for each (see [parseShortcutIcons]).
+ */
+enum class ShortcutIcon(val id: String, val icon: ImageVector, val label: Int, val route: String) {
+    RECOGNIZE("recognize", Icons.Rounded.Mic, R.string.recognition, "recognition"),
+    LISTEN_TOGETHER("listen_together", Icons.Rounded.Group, R.string.lt_title, "settings/listen_together"),
+    STATS("stats", Icons.AutoMirrored.Rounded.TrendingUp, R.string.stats, "stats"),
+    HISTORY("history", Icons.Rounded.History, R.string.history, "history"),
+    SETTINGS("settings", Icons.Rounded.Settings, R.string.settings, "settings"),
+    ACCOUNT("account", Icons.Rounded.Person, R.string.account, "settings/account_sync"),
+}
+
+/** What was always beside the search field. */
+const val DEFAULT_BESIDE_SEARCH_ICONS = "stats,settings,account"
+
+/** What was always inside it, when it is open: the identify button. */
+const val DEFAULT_IN_SEARCH_ICONS = "recognize"
+
+/** The icons named in [stored], in that order. Unknown names are skipped, and none is a real "none". */
+fun parseShortcutIcons(stored: String): List<ShortcutIcon> =
+    stored.split(',').mapNotNull { id -> ShortcutIcon.entries.find { it.id == id.trim() } }.distinct()
+
+/** One button for [icon], going where it goes. */
+@Composable
+fun ShortcutIconButton(icon: ShortcutIcon, navController: NavController) {
+    IconButton(onClick = { navController.navigate(icon.route) }) {
+        if (icon == ShortcutIcon.ACCOUNT) {
+            AccountAvatar(contentDescription = stringResource(icon.label)) {
+                Icon(icon.icon, contentDescription = stringResource(icon.label))
+            }
+        } else {
+            Icon(icon.icon, contentDescription = stringResource(icon.label))
+        }
+    }
+}
+
+/** The chosen icons side by side. */
+@Composable
+fun ShortcutIconRow(stored: String, navController: NavController, modifier: Modifier = Modifier) {
+    Row(verticalAlignment = Alignment.CenterVertically, modifier = modifier) {
+        parseShortcutIcons(stored).forEach { ShortcutIconButton(it, navController) }
+    }
+}
+
+/**
+ * Tick which icons show and drag them into order. The ones ticked, in the order shown, are what
+ * [onConfirm] gets, as the comma separated string that [parseShortcutIcons] reads.
+ */
+@Composable
+fun ShortcutIconsDialog(
+    title: String,
+    stored: String,
+    default: String,
+    onConfirm: (String) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val chosen = remember { parseShortcutIcons(stored) }
+    val order = remember { mutableStateListOf<ShortcutIcon>().apply { addAll(chosen + ShortcutIcon.entries.filter { it !in chosen }) } }
+    val ticked = remember { mutableStateListOf<ShortcutIcon>().apply { addAll(chosen) } }
+    val listState = rememberLazyListState()
+    val reorderState = rememberReorderableLazyListState(lazyListState = listState) { from, to ->
+        order.add(to.index, order.removeAt(from.index))
+    }
+
+    ActionPromptDialog(
+        title = title,
+        onDismiss = onDismiss,
+        onConfirm = {
+            onConfirm(order.filter { it in ticked }.joinToString(",") { it.id })
+            onDismiss()
+        },
+        onReset = {
+            val d = parseShortcutIcons(default)
+            order.clear(); order.addAll(d + ShortcutIcon.entries.filter { it !in d })
+            ticked.clear(); ticked.addAll(d)
+        },
+        onCancel = onDismiss,
+    ) {
+        LazyColumn(state = listState, modifier = Modifier.padding(vertical = 12.dp)) {
+            itemsIndexed(order, key = { _, item -> item.id }) { _, item ->
+                ReorderableItem(state = reorderState, key = item.id) {
+                    Row(
+                        horizontalArrangement = Arrangement.SpaceBetween,
+                        verticalAlignment = Alignment.CenterVertically,
+                        modifier = Modifier.padding(start = 4.dp, end = 12.dp).fillMaxWidth()
+                    ) {
+                        Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.weight(1f)) {
+                            Checkbox(
+                                checked = item in ticked,
+                                onCheckedChange = { on -> if (on) ticked.add(item) else ticked.remove(item) },
+                            )
+                            Icon(item.icon, null, tint = MaterialTheme.colorScheme.onSurfaceVariant)
+                            Spacer(Modifier.width(12.dp))
+                            Text(stringResource(item.label))
+                        }
+                        Icon(Icons.Rounded.DragHandle, null, modifier = Modifier.draggableHandle())
+                    }
+                }
+            }
+        }
+    }
+}
