+  info: 52, title: 28, artist: 24,
+  progress: 76, slider: 48, times: 16,
+  play: 72, button: 32, playGap: 8,
+  // The chosen player buttons: 36dp discs 7dp apart after a 10dp lead, each drawn 5dp below its
+  // place (PlayerButtonsRow's offset) - so the row is 36dp tall but the discs sit 5dp lower.
+  action: 36, actionGap: 7, actionLead: 10, actionRow: 36, actionDrop: 5,
+};
+const ACTION_COUNT = PLAYER_BUTTON_PLACEHOLDERS.length;
+const ACTIONS_W = DP.actionLead + ACTION_COUNT * DP.action + (ACTION_COUNT - 1) * DP.actionGap;
