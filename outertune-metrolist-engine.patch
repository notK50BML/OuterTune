+/*
+ * Copyright (C) 2026 OuterTune Project
+ *
+ * SPDX-License-Identifier: GPL-3.0
+ */
+
+package com.dd3boh.outertune.audio
+
+import com.dd3boh.outertune.models.EqualizerSettings
+import kotlin.math.abs
+import kotlin.math.exp
+import kotlin.math.ln
+import kotlin.math.sqrt
+
+/**
+ * Makes one pair of headphones sound like another.
+ *
+ * AutoEQ publishes, for each headphone, the filters that bring it to a common target: its
+ * correction C(f) = target - measured(f). Playing through headphones A and wanting the sound of B
+ * means adding what B has and A lacks, measured(B) - measured(A), which is C(A) - C(B). The two
+ * corrections are summed and subtracted as responses, in dB, over a log axis, and that difference
+ * is then fitted with a handful of peaking filters, since the equaliser has twelve bands.
+ *
+ * Limits worth knowing: it is the measured *frequency response* only, which is most of what makes
+ * two headphones sound different but not their distortion, imaging or isolation; the corrections
+ * are only meaningful up to around 10kHz, so the fit gives the top octave little weight; and
+ * boosts the curve asks for are made safe by the equaliser's own headroom and limiter, which
+ * measure the finished cascade, so this does not have to.
+ *
+ * No Android in here.
+ */
+object AutoEqMatch {
+
+    /** What the fit was able to do. [rmsErrorDb] is what is left over, weighted as the fit was. */
+    data class Result(val bands: List<EqualizerSettings.EqBand>, val rmsErrorDb: Float)
+
+    private const val SAMPLE_RATE = 48_000
+    private const val POINTS = 192
+    private const val LOW_HZ = 20f
+    private const val HIGH_HZ = 16_000f
+    private const val STOP_DB = 0.35f
+
+    private val grid = FloatArray(POINTS) { i ->
+        exp(ln(LOW_HZ) + (ln(HIGH_HZ) - ln(LOW_HZ)) * i / (POINTS - 1f))
+    }
+
+    /** Full weight to 8kHz, then falling to a third by 16kHz: the measurements stop being reliable up there. */
+    private val weight = FloatArray(POINTS) { i ->
+        val hz = grid[i]
+        if (hz <= 8_000f) 1f else 1f - 0.67f * ((ln(hz) - ln(8_000f)) / (ln(HIGH_HZ) - ln(8_000f)))
+    }
+
+    /** The response of [bands] on the fitting grid, in dB. */
+    internal fun responseDb(bands: List<EqualizerSettings.EqBand>): FloatArray {
+        val cascade = Array(bands.size) { BiquadCoefficients.forBand(bands[it], SAMPLE_RATE) }
+        return FloatArray(POINTS) { BiquadCoefficients.cascadeDb(cascade, grid[it], SAMPLE_RATE) }
+    }
+
+    private fun bandDb(band: EqualizerSettings.EqBand): FloatArray {
+        val c = arrayOf(BiquadCoefficients.forBand(band, SAMPLE_RATE))
+        return FloatArray(POINTS) { BiquadCoefficients.cascadeDb(c, grid[it], SAMPLE_RATE) }
+    }
+
+    /**
+     * The filters that make [from] sound like [to]. Both are AutoEQ corrections (the bands as
+     * [com.dd3boh.outertune.utils.AutoEqRepository] parses them).
+     */
+    fun match(
+        from: List<EqualizerSettings.EqBand>,
+        to: List<EqualizerSettings.EqBand>,
+        maxBands: Int = 10,
+    ): Result {
+        val a = responseDb(from)
+        val b = responseDb(to)
+        val target = FloatArray(POINTS) { a[it] - b[it] }
+        return fit(target, maxBands.coerceIn(1, EqualizerSettings.DEFAULT_BANDS.size))
+    }
+
+    /** Peaking filters fitted to [target] (dB on the grid): placed greedily, then each nudged. */
+    internal fun fit(target: FloatArray, maxBands: Int): Result {
+        val bands = ArrayList<EqualizerSettings.EqBand>()
+        val responses = ArrayList<FloatArray>()
+        val total = FloatArray(POINTS)
+
+        fun error(sum: FloatArray): Double {
+            var e = 0.0
+            for (i in 0 until POINTS) {
+                val d = (target[i] - sum[i]).toDouble()
+                e += weight[i] * d * d
+            }
+            return e
+        }
+
+        fun clamp(band: EqualizerSettings.EqBand) = band.copy(
+            freqHz = band.freqHz.coerceIn(LOW_HZ, HIGH_HZ),
+            gainDb = band.gainDb.coerceIn(EqualizerSettings.MIN_GAIN_DB, EqualizerSettings.MAX_GAIN_DB),
+            q = band.q.coerceIn(0.3f, 6f),
+        )
+
+        repeat(maxBands) {
+            // the worst place that is left, looked at over three points so a single spike is not chased
+            var worst = -1
+            var worstAbs = STOP_DB
+            for (i in 1 until POINTS - 1) {
+                val r = (target[i - 1] - total[i - 1] + target[i] - total[i] + target[i + 1] - total[i + 1]) / 3f
+                val w = abs(r) * weight[i]
+                if (w > worstAbs) { worstAbs = w; worst = i }
+            }
+            if (worst < 0) return@repeat
+            val residual = target[worst] - total[worst]
+            val band = clamp(
+                EqualizerSettings.EqBand(freqHz = grid[worst], gainDb = residual * 0.9f, q = 1.2f)
+            )
+            val response = bandDb(band)
+            bands += band
+            responses += response
+            for (i in 0 until POINTS) total[i] += response[i]
+
+            // Each band's frequency, gain and Q nudged in turn, keeping a change only if the whole
+            // fit gets better. A few sweeps are enough for the shapes headphones have.
+            repeat(3) {
+                for (k in bands.indices) {
+                    var best = bands[k]
+                    var bestResponse = responses[k]
+                    val without = FloatArray(POINTS) { total[it] - responses[k][it] }
+                    var bestError = error(total)
+                    val candidates = listOf(
+                        best.copy(freqHz = best.freqHz * 1.12f), best.copy(freqHz = best.freqHz / 1.12f),
+                        best.copy(gainDb = best.gainDb + 0.5f), best.copy(gainDb = best.gainDb - 0.5f),
+                        best.copy(q = best.q * 1.25f), best.copy(q = best.q / 1.25f),
+                    )
+                    for (candidate in candidates) {
+                        val c = clamp(candidate)
+                        val r = bandDb(c)
+                        val sum = FloatArray(POINTS) { without[it] + r[it] }
+                        val e = error(sum)
+                        if (e < bestError) { bestError = e; best = c; bestResponse = r }
+                    }
+                    if (bestResponse !== responses[k]) {
+                        bands[k] = best
+                        responses[k] = bestResponse
+                        for (i in 0 until POINTS) total[i] = without[i] + bestResponse[i]
+                    }
+                }
+            }
+        }
+
+        var weightSum = 0.0
+        for (w in weight) weightSum += w
+        val rms = sqrt(error(total) / weightSum).toFloat()
+        return Result(bands.sortedBy { it.freqHz }, rms)
+    }
+}
