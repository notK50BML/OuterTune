+        val asLrc = LrcParser.parseAny("[00:10.00]Delta", "BetterLyrics")
+        assertEquals("Delta", asLrc.lines.single().text)
+    }
+
+    // ---- Enhanced LRC ----------------------------------------------------------------------
+
+    @Test
