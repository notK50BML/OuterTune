+@Composable
+fun Modifier.holdNextPreview(playerConnection: PlayerConnection): Modifier {
+    val enabled by rememberPreference(HoldNextPreviewKey, defaultValue = false)
+    if (!enabled) return this
+    val scope = rememberCoroutineScope()
+    val swipePx = with(androidx.compose.ui.platform.LocalDensity.current) { 56.dp.toPx() }
+    val longPressMs = LocalViewConfiguration.current.longPressTimeoutMillis
+    val state = remember { PreviewState() }
+
+    suspend fun fadeTo(target: Float, ms: Long) {
+        val from = NextPreview.factor.value
+        val steps = (ms / 25).toInt().coerceAtLeast(1)
+        for (i in 1..steps) {
+            NextPreview.factor.value = from + (target - from) * i / steps
+            delay(25)
+        }
+        NextPreview.factor.value = target
+    }
+
+    return this.pointerInput(playerConnection) {
+        awaitEachGesture {
+            val down = awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
+            var released = false
+            withTimeoutOrNull(longPressMs) {
+                waitForUpOrCancellation(PointerEventPass.Initial)
+                released = true
+            }
+            if (released) return@awaitEachGesture // a plain tap: the button handles it
+
+            val player = playerConnection.player
+            val nextIndex = player.nextMediaItemIndex
+            if (nextIndex == androidx.media3.common.C.INDEX_UNSET) return@awaitEachGesture
+            state.job?.cancel()
+            state.origIndex = player.currentMediaItemIndex
+            state.origPos = player.currentPosition
+            state.wasPlaying = player.playWhenReady
+            state.committed = false
+            val nextTitle = player.getMediaItemAt(nextIndex).mediaMetadata.title?.toString().orEmpty()
+            state.job = scope.launch {
+                fadeTo(0f, 250)
+                player.seekToNextMediaItem()
+                player.play()
+                NextPreview.title.value = nextTitle
+                fadeTo(1f, 400)
+            }
+
+            while (true) {
+                val event = awaitPointerEvent(PointerEventPass.Initial)
+                event.changes.forEach { it.consume() } // the button must not also see this as a click
+                val change = event.changes.firstOrNull { it.id == down.id } ?: break
+                if (!change.pressed) break
+                if (!state.committed && change.position.x - down.position.x > swipePx) {
+                    state.committed = true
+                    NextPreview.title.value = null
+                }
+            }
+
+            if (!state.committed) {
+                val pending = state.job
+                state.job = scope.launch {
+                    pending?.join()
+                    fadeTo(0f, 250)
+                    player.seekTo(state.origIndex, state.origPos)
+                    if (!state.wasPlaying) player.pause()
+                    NextPreview.title.value = null
+                    fadeTo(1f, 400)
+                }
+            }
+        }
+    }
+}
+
+private class PreviewState {
+    var job: Job? = null
+    var origIndex = 0
+    var origPos = 0L
+    var wasPlaying = false
+    var committed = false
+}
+
+/** "Previewing [song]", shown above the cover while a preview plays (if the setting allows). */
+@Composable
+fun PreviewLabel() {
+    val show by rememberPreference(ShowPreviewLabelKey, defaultValue = true)
+    val title by NextPreview.title.collectAsState()
+    val t = title
+    if (!show || t == null) return
+    Box(Modifier.fillMaxWidth().padding(horizontal = 24.dp, vertical = 4.dp), contentAlignment = Alignment.Center) {
+        Text(
+            "Previewing $t",
+            style = MaterialTheme.typography.labelLarge,
+            color = MaterialTheme.colorScheme.primary,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
