From 9b982204c3145f767066fad675587e56f5e774e3 Mon Sep 17 00:00:00 2001
From: test <t@t>
Date: Sat, 5 Sep 2026 14:30:57 +0800
Subject: [PATCH 286/547] Build workflows: check the patch's base instead of a
 stale size

The apply step compared the patch against hardcoded numbers - a sha256,
a byte count, a commit count. Those were written down once and never
updated, so they described a patch from 171 commits ago and reported
every correct patch since as wrong. Worse than not checking. They are
measured now.

What is actually worth checking is the base. git format-patch --base
records the commit a patch was built against, and the step now reads it
back: if this checkout is not that commit, it moves there before
applying, and if the commit is absent from the repository entirely it
says so in one line.

That turns the most likely failure into a sentence rather than a wall of
rejected diff. And it happens for an ordinary reason - the workflow is
dispatched against a branch, and a branch that already contains the
patch's commits is not a valid base for replaying them. Every commit
would be "already present", and the skip loop would run out long before
reaching the end. Now it works from any branch that has the base
anywhere in its history.

The patch is copied aside before the reset, since the base predates the
patch file being tracked - resetting to it would otherwise delete the
file about to be applied.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .github/workflows/build-new-patched.yml     | 37 ++++++++++++++++++---
 .github/workflows/build-patched-backlog.yml | 37 ++++++++++++++++++---
 .github/workflows/build-patched.yml         | 37 ++++++++++++++++++---
 3 files changed, 96 insertions(+), 15 deletions(-)

diff --git a/.github/workflows/build-new-patched.yml b/.github/workflows/build-new-patched.yml
index be2323d0e..6217cf411 100644
--- a/.github/workflows/build-new-patched.yml
+++ b/.github/workflows/build-new-patched.yml
@@ -75,16 +75,43 @@ jobs:
           fi
 
           # Everything needed to tell a bad base apart from a bad patch file, printed before
-          # anything can go wrong. The expected sha256 is the one for the current patch; if
-          # it differs, the file in this repo is not the file that was generated.
+          # anything can go wrong. Measured, never hardcoded: an expected size written down by
+          # hand goes stale the first time the patch is regenerated, and then it reports every
+          # correct patch as wrong - which is worse than not checking at all.
           echo "===== BASE ====="
           git rev-parse HEAD
           git log --oneline -3
           echo "===== PATCH FILE ====="
           sha256sum "$PATCH"
-          echo "expected: d2db6c4c06712cb1d1cd7363a32fb5339b5ef7baed0020816693c5a230af1d67"
-          echo "lines: $(wc -l < "$PATCH")  (expected 33439)   bytes: $(wc -c < "$PATCH")  (expected 1665121)"
-          echo "commits in patch: $(grep -c '^From ' "$PATCH")  (expected 113)"
+          echo "commits: $(grep -c '^From ' "$PATCH")   lines: $(wc -l < "$PATCH")   bytes: $(wc -c < "$PATCH")"
+
+          # git format-patch --base records the commit the patch was built against. Checking it
+          # turns the single most common failure into one line instead of a wall of rejected diff:
+          # the patch is fine, this checkout is simply not where it starts from.
+          #
+          # That happens for an ordinary reason. This workflow is dispatched against a branch, and
+          # a branch that already contains the patch's commits is not a valid base for replaying
+          # them - every commit would be "already present", and the skip loop below would run out
+          # long before it reached the end.
+          WANT_BASE="$(sed -n 's/^base-commit: //p' "$PATCH" | tail -1)"
+          if [ -n "$WANT_BASE" ]; then
+            echo "patch base: $WANT_BASE"
+            if ! git cat-file -e "${WANT_BASE}^{commit}" 2>/dev/null; then
+              echo "::error::This checkout does not contain the commit this patch was built on."
+              echo "::error::Wanted $WANT_BASE - it is not in this repository's history."
+              exit 1
+            fi
+            if [ "$(git rev-parse HEAD)" != "$WANT_BASE" ]; then
+              echo "::notice::HEAD is $(git rev-parse --short HEAD); the patch starts from $(git rev-parse --short "$WANT_BASE"). Moving there."
+              # Copied out first: the base predates the patch file being tracked, so resetting to
+              # it would delete the very file about to be applied.
+              cp "$PATCH" /tmp/patch.mbox
+              git reset --hard "$WANT_BASE"
+              PATCH=/tmp/patch.mbox
+            fi
+          else
+            echo "patch declares no base commit - applying against this checkout as-is."
+          fi
           echo "================"
 
           git config user.name "github-actions"
diff --git a/.github/workflows/build-patched-backlog.yml b/.github/workflows/build-patched-backlog.yml
index 1dfaf9e47..e3110dc6f 100644
--- a/.github/workflows/build-patched-backlog.yml
+++ b/.github/workflows/build-patched-backlog.yml
@@ -75,16 +75,43 @@ jobs:
           fi
 
           # Everything needed to tell a bad base apart from a bad patch file, printed before
-          # anything can go wrong. The expected sha256 is the one for the current patch; if
-          # it differs, the file in this repo is not the file that was generated.
