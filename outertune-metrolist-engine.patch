+  { id: "play_pause",    label: "Play / pause",  knobs: ["scale", "rot"], locked: true },
+  { id: "seek_forward",  label: "Seek forward",  knobs: ["scale", "rot"] },
+  { id: "skip_next",     label: "Next",          knobs: ["scale", "rot"] },
+  { id: "repeat",        label: "Repeat",        knobs: ["scale", "rot"] },
+
+  { id: "sleep_timer",   label: "Sleep timer",   knobs: ["scale", "rot"] },
+  { id: "like",          label: "Like",          knobs: ["scale", "rot"] },
+  { id: "equalizer",     label: "Equalizer",     knobs: ["scale", "rot"] },
+  { id: "menu",          label: "Overflow menu", knobs: ["scale", "rot"] },
+
+  { id: "queue",    label: "Queue handle",       knobs: ["rot"] },
