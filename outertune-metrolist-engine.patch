+import com.dd3boh.outertune.utils.AutoEqRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * "Make these headphones sound like those": pick the headphones in use, then the ones to imitate,
+ * and the difference between their AutoEQ corrections is fitted to a curve (see [AutoEqMatch]).
+ * [onApply] gets that curve, with the fit's leftover error in dB so it can be shown.
+ */
+@Composable
+fun AutoEqMatchDialog(onApply: (EqualizerSettings) -> Unit, onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val detected = remember { connectedHeadphoneName(context) }
+    var step by remember { mutableStateOf(0) }
+    var source by remember { mutableStateOf<AutoEqRepository.Result?>(null) }
+    var query by remember { mutableStateOf(detected.orEmpty()) }
+    var results by remember { mutableStateOf<List<AutoEqRepository.Result>>(emptyList()) }
+    var searching by remember { mutableStateOf(false) }
+    var working by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf<String?>(null) }
+    val scope = rememberCoroutineScope()
+    val rateLimited = stringResource(R.string.eq_settings_autoeq_rate_limited)
+    val unreachable = stringResource(R.string.eq_settings_autoeq_unreachable)
+    val failed = stringResource(R.string.eq_match_failed)
+
+    LaunchedEffect(query) {
+        val q = query.trim()
+        if (q.isEmpty()) { results = emptyList(); searching = false; error = null; return@LaunchedEffect }
+        delay(400)
+        searching = true
+        error = null
+        val outcome = runCatching { AutoEqRepository.search(q) }.getOrNull()
+        searching = false
+        when (outcome) {
+            is AutoEqRepository.SearchOutcome.Found -> results = outcome.results
+            AutoEqRepository.SearchOutcome.RateLimited -> { results = emptyList(); error = rateLimited }
+            else -> { results = emptyList(); error = unreachable }
+        }
+    }
+
+    fun picked(result: AutoEqRepository.Result) {
+        if (step == 0) {
+            source = result
+            step = 1
+            query = ""
+            results = emptyList()
+            return
+        }
+        val from = source ?: return
+        scope.launch {
+            working = true
+            error = null
+            val a = AutoEqRepository.fetchCurve(from)
+            val b = AutoEqRepository.fetchCurve(result)
+            if (a == null || b == null) {
+                working = false
+                error = failed
+                return@launch
+            }
+            val fitted = withContext(Dispatchers.Default) { AutoEqMatch.match(a.bands, b.bands) }
+            working = false
+            onApply(EqualizerSettings.DEFAULT.copy(enabled = true, bands = fitted.bands))
+            onDismiss()
+        }
+    }
+
+    DefaultDialog(
+        onDismiss = onDismiss,
+        icon = { Icon(Icons.Rounded.Search, null) },
+        title = { Text(stringResource(R.string.eq_match_title)) },
+        buttons = {
+            if (step == 1 && !working) {
+                TextButton(onClick = { step = 0; source = null; query = detected.orEmpty() }) {
+                    Text(stringResource(R.string.eq_match_back))
+                }
+            }
+            TextButton(onClick = onDismiss) { Text(stringResource(android.R.string.cancel)) }
+        }
+    ) {
+        Text(
+            text = if (step == 0) stringResource(R.string.eq_match_step_from)
+            else stringResource(R.string.eq_match_step_to, source?.name.orEmpty()),
+            style = MaterialTheme.typography.bodyMedium,
+        )
+        Spacer(Modifier.height(8.dp))
+        OutlinedTextField(
+            value = query,
+            onValueChange = { query = it },
+            modifier = Modifier.fillMaxWidth(),
+            label = { Text(stringResource(R.string.eq_settings_autoeq_search_hint)) },
+            singleLine = true,
+            enabled = !working,
+            keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
+        )
+        if (step == 0 && detected != null) {
+            Text(
+                text = stringResource(R.string.eq_settings_autoeq_detected, detected),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(top = 4.dp),
+            )
+        }
+        Spacer(Modifier.height(8.dp))
+        when {
+            working || searching -> Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.padding(vertical = 8.dp)) {
+                CircularProgressIndicator(modifier = Modifier.size(20.dp), strokeWidth = 2.dp)
+                Spacer(Modifier.width(12.dp))
+                Text(stringResource(if (working) R.string.eq_match_working else R.string.eq_settings_autoeq_searching))
+            }
+            error != null -> Text(error.orEmpty(), color = MaterialTheme.colorScheme.error)
+            query.isNotBlank() && results.isEmpty() -> Text(stringResource(R.string.eq_settings_autoeq_no_results))
+        }
+        LazyColumn(modifier = Modifier.fillMaxWidth().heightIn(max = 300.dp)) {
+            items(results, key = { "${it.category}/${it.name}" }) { result ->
+                Column(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clickable(enabled = !working) { picked(result) }
+                        .padding(vertical = 10.dp)
+                ) {
+                    Text(result.name, maxLines = 1, overflow = TextOverflow.Ellipsis)
+                    Text(
+                        result.category,
+                        style = MaterialTheme.typography.labelSmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+            }
+        }
+        if (step == 1) {
+            Text(
+                text = stringResource(R.string.eq_match_note),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(top = 8.dp),
+            )
+        }
+    }
+}
