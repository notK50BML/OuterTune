+/**
+ * The button itself: glass while its screen is under a [GlassHost] and floating buttons have glass
+ * on, in the button's own container colour so it still reads as a button; a plain FAB otherwise.
+ * Drawn by the host, since the button is inside the screen (see GlassHost.kt).
+ */
+@Composable
+private fun FloatingButton(onClick: () -> Unit, content: @Composable () -> Unit) {
+    val host = LocalGlassHost.current
+    val config = LocalGlassConfig.current
+    if (host == null || !config.fab) {
+        FloatingActionButton(modifier = Modifier.padding(16.dp), onClick = onClick, content = content)
+        return
+    }
+    val glass = GlassSpec(host.backdrop, config.intensity)
+    val shape = FloatingActionButtonDefaults.shape
+    FloatingActionButton(
+        modifier = Modifier
+            .padding(16.dp)
+            .drawnBy(host)
+            .graphicsLayer()
+            .glassPanel(glass, shape, MaterialTheme.colorScheme.primaryContainer.copy(alpha = glass.tintAlpha(min = 0.6f, max = 0.95f))),
+        onClick = onClick,
+        shape = shape,
+        containerColor = Color.Transparent,
+        contentColor = MaterialTheme.colorScheme.onPrimaryContainer,
+        elevation = FloatingActionButtonDefaults.elevation(0.dp, 0.dp, 0.dp, 0.dp),
+        content = content,
+    )
+}
