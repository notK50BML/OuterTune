+            description = stringResource(R.string.player_auto_text_contrast_description),
+            icon = { Icon(Icons.Rounded.Contrast, null) },
+            checked = autoTextContrast,
+            onCheckedChange = onAutoTextContrastChange,
+        )
+    }
