From 23f8900b0d2d48e913ab67d9077c8aa1a6d9f4bc Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Sun, 18 Oct 2026 19:04:27 +0800
Subject: [PATCH 423/547] Desktop: the search box's clear button clears instead
 of closing the search

The button took focus when clicked, which took it off the box and closed the suggestions. It no
longer takes focus, and hands it back to the box after clearing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../main/kotlin/com/dd3boh/outertune/desktop/Main.kt  | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Main.kt b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Main.kt
index 2150f9b59..eb003961a 100644
--- a/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Main.kt
+++ b/desktop/src/main/kotlin/com/dd3boh/outertune/desktop/Main.kt
@@ -79,6 +79,7 @@ import androidx.compose.ui.Alignment
 import androidx.compose.ui.Modifier
 import androidx.compose.ui.focus.FocusRequester
 import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.focus.focusProperties
 import androidx.compose.ui.focus.onFocusChanged
 import androidx.compose.ui.graphics.Color
 import androidx.compose.ui.input.key.Key
@@ -1398,7 +1399,15 @@ private fun SearchBar(
         trailingIcon = {
             when {
                 searching -> CircularProgressIndicator(modifier = Modifier.size(20.dp), strokeWidth = 2.dp)
-                query.isNotEmpty() -> IconButton(onClick = { onQueryChange("") }) {
+                // Never takes focus itself: a click moving focus here took it off the box, which
+                // closed the search instead of clearing it. Clears and keeps typing in the box.
+                query.isNotEmpty() -> IconButton(
+                    onClick = {
+                        onQueryChange("")
+                        runCatching { focus.requestFocus() }
+                    },
+                    modifier = Modifier.focusProperties { canFocus = false },
+                ) {
                     Icon(OuterTuneIcons.close, contentDescription = "Clear", modifier = Modifier.size(20.dp))
                 }
             }
-- 
