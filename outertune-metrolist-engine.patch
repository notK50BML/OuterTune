+    )
+    PreferenceEntry(
+        title = { Text(stringResource(R.string.profile_export)) },
+        icon = { Icon(Icons.Rounded.Upload, null) },
+        onClick = { choosingExport = true },
+    )
+    PreferenceEntry(
+        title = { Text(stringResource(R.string.profile_import)) },
