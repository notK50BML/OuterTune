+ * the row sits above the list, and each switched-on item carries its position counted from the
+ * left. Top of the list is leftmost. Arrows rather than dragging, because a list of a dozen rows
+ * is quicker to nudge with a mouse than to drag.
+ */
+@Composable
+fun PlayerButtonsDialog(
+    current: List<PlayerButtonKind>,
+    onSave: (List<PlayerButtonKind>) -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val items = remember {
+        mutableStateListOf<Pair<PlayerButtonKind, Boolean>>().apply {
+            addAll(current.map { it to true })
+            addAll(PlayerButtonKind.entries.filterNot { it in current }.map { it to false })
+        }
+    }
+    var refused by remember { mutableStateOf(false) }
+    val chosen = items.filter { it.second }.map { it.first }
+
+    fun reset() {
+        val defaults = PlayerButtonKind.decode(PlayerButtonKind.DEFAULT)
+        items.clear()
+        items.addAll(defaults.map { it to true })
+        items.addAll(PlayerButtonKind.entries.filterNot { it in defaults }.map { it to false })
+        refused = false
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Player buttons") },
+        confirmButton = { TextButton(onClick = { onSave(chosen) }) { Text("Save") } },
+        dismissButton = {
+            Row {
+                TextButton(onClick = ::reset) { Text("Reset") }
+                TextButton(onClick = onDismiss) { Text("Cancel") }
+            }
+        },
+        text = {
+            Column(modifier = Modifier.width(460.dp)) {
+                Text(
+                    "Preview",
+                    style = MaterialTheme.typography.labelMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(7.dp),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(vertical = 8.dp)
+                        .clip(RoundedCornerShape(12.dp))
+                        .background(MaterialTheme.colorScheme.surfaceContainerHigh)
+                        .padding(horizontal = 12.dp, vertical = 8.dp),
+                ) {
+                    Text(
+                        "♪  Song title",
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        modifier = Modifier.weight(1f),
+                    )
+                    chosen.forEach { PreviewDisc(it) }
+                }
+                Hint(
+                    "Top of the list is the leftmost button. Click to turn on or off, arrows to " +
+                        "reorder. Up to ${PlayerButtonKind.MAX}."
+                )
+                if (refused) Hint("Up to ${PlayerButtonKind.MAX} buttons. Turn one off first.", error = true)
+                if (PlayerButtonKind.MENU !in chosen) {
+                    Hint("Without More options, anything not shown as a button cannot be reached from the player.", error = true)
+                }
+                Spacer(modifier = Modifier.height(8.dp))
+                Column(
+                    modifier = Modifier
+                        .heightIn(max = 380.dp)
+                        .border(1.dp, MaterialTheme.colorScheme.outlineVariant, RoundedCornerShape(12.dp))
+                        .verticalScroll(rememberScrollState()),
+                ) {
+                    items.forEachIndexed { index, (button, on) ->
+                        val position = chosen.indexOf(button)
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    if (!on && chosen.size >= PlayerButtonKind.MAX) {
+                                        refused = true
+                                    } else {
+                                        refused = false
+                                        items[index] = button to !on
+                                    }
+                                }
+                                .padding(horizontal = 12.dp, vertical = 4.dp),
+                        ) {
+                            Box(
+                                contentAlignment = Alignment.Center,
+                                modifier = Modifier
+                                    .size(24.dp)
+                                    .clip(CircleShape)
+                                    .background(if (on) MaterialTheme.colorScheme.primary else Color.Transparent)
+                                    .border(
+                                        1.dp,
+                                        MaterialTheme.colorScheme.outline.copy(alpha = if (on) 0f else 0.6f),
+                                        CircleShape,
+                                    ),
+                            ) {
+                                if (on) {
+                                    Text(
+                                        "${position + 1}",
+                                        color = MaterialTheme.colorScheme.onPrimary,
+                                        style = MaterialTheme.typography.labelMedium,
+                                        fontWeight = FontWeight.Bold,
+                                    )
+                                }
+                            }
+                            Spacer(modifier = Modifier.width(12.dp))
+                            PreviewDisc(button, dimmed = !on)
+                            Spacer(modifier = Modifier.width(12.dp))
+                            Text(
+                                button.label,
+                                color = if (on) MaterialTheme.colorScheme.onSurface else MaterialTheme.colorScheme.onSurfaceVariant,
+                                modifier = Modifier.weight(1f),
+                            )
+                            IconButton(
+                                onClick = { items.add(index - 1, items.removeAt(index)) },
+                                enabled = index > 0,
+                            ) {
+                                Icon(OuterTuneIcons.expandLess, "Move up", modifier = Modifier.size(20.dp))
+                            }
+                            IconButton(
+                                onClick = { items.add(index + 1, items.removeAt(index)) },
+                                enabled = index < items.lastIndex,
+                            ) {
+                                Icon(OuterTuneIcons.expandLess, "Move down", modifier = Modifier.size(20.dp).rotate(180f))
+                            }
+                        }
+                    }
+                }
+            }
+        },
+    )
+}
+
+@Composable
+private fun PreviewDisc(button: PlayerButtonKind, dimmed: Boolean = false) {
+    Box(
+        contentAlignment = Alignment.Center,
+        modifier = Modifier
+            .size(30.dp)
+            .clip(CircleShape)
+            .background(MaterialTheme.colorScheme.primary.copy(alpha = if (dimmed) 0.35f else 1f)),
+    ) {
+        Icon(button.icon, contentDescription = null, tint = MaterialTheme.colorScheme.onPrimary, modifier = Modifier.size(18.dp))
+    }
+}
+
+@Composable
+private fun Hint(text: String, error: Boolean = false) {
+    Text(
+        text,
+        style = MaterialTheme.typography.bodySmall,
+        color = if (error) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurfaceVariant,
+        modifier = Modifier.padding(vertical = 2.dp),
+    )
+}
