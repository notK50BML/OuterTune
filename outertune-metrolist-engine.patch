+                val winner = dupes.firstOrNull { it.id == canonicalId }
+                    ?: dupes.firstOrNull { it.isYouTubeArtist }
+                    ?: dupes.first()
+                winners[key] = winner
+                Timber.tag(TAG).d(
+                    "[$songId] \"${dupes.first().name}\" credited ${dupes.size}x " +
+                        "(${dupes.joinToString { it.id }}) - keeping ${winner.id}"
+                )
+            }
