 .../outertune/ui/component/RotaryDial.kt      |  62 ++--
 .../outertune/ui/player/EqualizerPanel.kt     | 322 ++++++++++++------
 .../outertune/ui/player/LiquidBackground.kt   | 177 ++++++----
 .../com/dd3boh/outertune/ui/player/Player.kt  |   8 +-
 5 files changed, 377 insertions(+), 201 deletions(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt b/app/src/main/java/com/dd3boh/outertune/ui/component/Lyrics.kt
