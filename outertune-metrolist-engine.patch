+  const units = layoutUnits(stacked).map(u => u.kind === "single" ? [u.block] : u.members);
+  const unitH = u => u.length === 1 && !isButton(u[0].id) ? naturalH(u[0].id) : Math.max(...u.map(b => naturalH(b.id)));
+  const total = units.reduce((a, u) => a + unitH(u), 0) + sp * Math.max(units.length - 1, 0);
+  const bottom = H - nav - DP.peek - DP.spacer;
+  const top = bottom - total;
