+        )
+    }
+
+    @Test
+    fun `blank and empty input survive`() {
+        assertEquals("", cleanLyrics(""))
+        assertEquals("", cleanLyrics("   "))
+    }
+
+    @Test
+    fun `timestamps are never altered`() {
+        val stamped = "[00:12.34]>> [Music] Never gonna give"
+        assertTrue(cleanLyrics(stamped).startsWith("[00:12.34]"))
+    }
