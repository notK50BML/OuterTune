+                        onTapLabel = { selectedBand = if (selectedBand == index) null else index },
+                    )
+                }
+            }
+
+            selectedBand?.let { index ->
+                HorizontalDivider(
+                    modifier = Modifier.fillMaxWidth(),
+                    color = eqColorVariant.copy(alpha = 0.3f),
