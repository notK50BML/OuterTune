+                // inside a scrolling column and a lazy grid inside one has no height to measure.
+                AppIcon.entries.chunked(3).forEach { row ->
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.SpaceEvenly,
+                    ) {
