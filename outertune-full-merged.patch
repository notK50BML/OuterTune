+                onTrebleChange = { setRangeGain(trebleBandIndices, it) },
+                onBalanceChange = { update(settings.copy(balance = it)) },
+            )
+        }
+
+        EqualizerCard {
+            LazyRow(
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                modifier = Modifier
