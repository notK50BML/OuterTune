<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's outline, for clipToOutline on Android 12+: the corners are cut by the system at
     full screen resolution instead of being drawn into a small picture that is then stretched. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <corners android:radius="24dp" />
</shape>
