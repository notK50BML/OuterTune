<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the widget is pushed to by the music service whenever the song or the
     play state changes, so a periodic wake-up would only cost battery. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_player"
    android:minWidth="250dp"
    android:minHeight="100dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_player"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
