<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the widget. Elements are added to it left to right; flexible ones carry weight 1.
     Centred, so a row of buttons sits in the middle rather than against the left edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="3dp"
    android:gravity="center"
    android:orientation="horizontal" />
