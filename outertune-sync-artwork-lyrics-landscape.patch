+}
+
+@Serializable
+data class ShazamResponseJson(
+    @SerialName("matches")
+    val matches: List<Match?>? = null,
+    @SerialName("location")
+    val location: Location? = null,
+    @SerialName("timestamp")
+    val timestamp: Long? = null,
+    @SerialName("timezone")
+    val timezone: String? = null,
+    @SerialName("track")
