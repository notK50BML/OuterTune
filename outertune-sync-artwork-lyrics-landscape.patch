+                    drawText(layout, color = sungColor)
+                }
+                drawRect(
+                    brush = gradient,
+                    topLeft = Offset(0f, bandTop),
+                    size = Size(size.width, bandBottom - bandTop),
+                    blendMode = BlendMode.DstIn,
+                )
