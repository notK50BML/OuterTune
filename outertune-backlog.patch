+        // Pattern 4: String.fromCharCode(110) variant (110 = 'n')
+        Regex("""\(\s*([a-zA-Z0-9$]+)\s*=\s*String\.fromCharCode\(110\)"""),
+        // Pattern 5: enhanced_except_ function pattern
+        Regex("""([a-zA-Z0-9$]+)\s*=\s*function\([a-zA-Z0-9]\)\s*\{[^}]*?enhanced_except_"""),
+    )
