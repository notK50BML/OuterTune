     fun loadMore() {
+        if (loadingMore) return
+        val oldItemsPage = itemsPage.value ?: return
+        val continuation = oldItemsPage.continuation ?: return
+        loadingMore = true
         viewModelScope.launch {
-            val oldItemsPage = itemsPage.value ?: return@launch
