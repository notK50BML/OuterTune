From 87e35ff9b182ab3763601459b1b7419c1600aaff Mon Sep 17 00:00:00 2001
From: claude <claude@local>
Date: Thu, 13 Aug 2026 16:29:22 +0800
Subject: [PATCH 066/180] Refine the equalizer's built-in presets to feel
 closer to Poweramp's

Loudness becomes a proper Fletcher-Munson smile curve, plus two more Poweramp-signature presets (Small Speakers, Full Bass & Treble).
---
 .../com/dd3boh/outertune/models/EqualizerSettings.kt     | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/models/EqualizerSettings.kt b/app/src/main/java/com/dd3boh/outertune/models/EqualizerSettings.kt
index 1ecfc377..29258783 100644
--- a/app/src/main/java/com/dd3boh/outertune/models/EqualizerSettings.kt
+++ b/app/src/main/java/com/dd3boh/outertune/models/EqualizerSettings.kt
@@ -148,7 +148,14 @@ data class EqualizerSettings(
             "Dance" to listOf(6f, 6f, 5f, 3f, 0f, -2f, -1f, 1f, 3f, 5f, 5f, 5f),
             "Hip-Hop" to listOf(7f, 6f, 5f, 3f, 1f, 0f, 1f, 2f, 2f, 1f, 0f, 0f),
             "Acoustic" to listOf(2f, 2f, 1f, 1f, 0f, 0f, 1f, 2f, 2f, 1f, 1f, 2f),
-            "Loudness" to listOf(6f, 5f, 3f, 1f, 0f, -1f, -1f, 0f, 1f, 3f, 4f, 5f),
+            // A Fletcher-Munson "smile": ears are least sensitive to bass/treble at low listening
+            // volumes, so boosting both ends (and leaving the mids alone) is what actually makes
+            // quiet playback sound full instead of thin - the classic loudness-compensation curve.
+            "Loudness" to listOf(9f, 8f, 6f, 3f, 0f, 0f, 0f, 1f, 3f, 6f, 8f, 9f),
+            // Small/phone speakers can't reproduce sub-bass or air at all - push both extremes
