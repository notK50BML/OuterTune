+
 
 
     /**
@@ -85,13 +91,31 @@ object YTPlayerUtils {
             ("403" in message && "We're sorry" in message)
     }
 
+    private const val WEB_REMIX_FAILURE_TTL_MS = 5 * 60 * 1000L
