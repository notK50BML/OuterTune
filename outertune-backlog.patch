From d625310148632c714852b2cdb7570cb2f857de61 Mon Sep 17 00:00:00 2001
From: claude <claude@local>
Date: Fri, 21 Aug 2026 20:51:31 +0800
Subject: [PATCH 128/180] Enrich an existing song's artists/genres instead of
 discarding them

insert(mediaMetadata) returned immediately whenever the SongEntity insert
hit its OnConflictStrategy.IGNORE (song already in the DB) - meaning a
song first cached sparsely from search/queue/related results stayed
stuck with that artist list forever, even when later viewed via its own
album's track listing, whose API response can credit more artists for
the exact same song. AlbumPage parsing already builds each track's own
artist list straight from the album's renderer data independently of
whatever a prior sparse fetch stored, but that richer list never got
past the early return to reach the artist/genre insert loops.

Those loops are already OnConflictStrategy.IGNORE on [songId, artistId]/
[songId, genreId], so running them for an existing song only ever adds a
mapping that was missing - it can't duplicate or remove one that's
already there. The album-linking block below them stayed gated to the
song's actual first insert, since unlike the mappings it isn't
idempotent (it adds to the album's running duration every time it runs).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .../java/com/dd3boh/outertune/db/DatabaseDao.kt    | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/db/DatabaseDao.kt b/app/src/main/java/com/dd3boh/outertune/db/DatabaseDao.kt
index ff43ce9d..62be8457 100644
--- a/app/src/main/java/com/dd3boh/outertune/db/DatabaseDao.kt
+++ b/app/src/main/java/com/dd3boh/outertune/db/DatabaseDao.kt
@@ -165,7 +165,15 @@ interface DatabaseDao : SongsDao, AlbumsDao, ArtistsDao, PlaylistsDao, QueueDao
 
     @Transaction
     fun insert(mediaMetadata: MediaMetadata, block: (SongEntity) -> SongEntity = { it }) {
-        if (insert(mediaMetadata.toSongEntity().let(block)) == -1L) return
+        val isNewSong = insert(mediaMetadata.toSongEntity().let(block)) != -1L
+        // Artist/genre mappings run even for a song that already existed: one first cached from a
+        // sparse source (search, queue, related) can be missing artists a richer source - e.g. the
+        // very album this call came from - actually credits it with, and previously this whole
+        // function returned immediately on the SongEntity insert's OnConflictStrategy.IGNORE,
+        // silently discarding that richer artist list. The inserts below are already
+        // OnConflictStrategy.IGNORE on [songId, artistId]/[songId, genreId], so re-running this for
+        // an existing song only ever adds a mapping that was missing, never duplicates or removes
+        // one that's already there.
         mediaMetadata.artists.forEachIndexed { index, artist ->
             val artistId = artist.id ?: artistByName(artist.name)?.id ?: ArtistEntity.generateArtistId()
             insert( // TODO: use upsert???
@@ -201,6 +209,10 @@ interface DatabaseDao : SongsDao, AlbumsDao, ArtistsDao, PlaylistsDao, QueueDao
             )
         }
 
+        // Unlike the mappings above, this isn't idempotent - it adds mediaMetadata.duration to the
+        // album's running total every time it runs, so it must stay gated to the song's actual
+        // first insert or a re-view of an already-known song would keep inflating that total.
+        if (!isNewSong) return
