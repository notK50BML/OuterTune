+                if (reveal < layout.getLineEnd(line).toFloat()) {
+                    boundaryLine = line
+                    break
+                }
+            }
+            if (boundaryLine == -1) {
+                drawText(layout, color = sungColor) // the whole line has been sung
+                return@Canvas
+            }
