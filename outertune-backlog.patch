+            }.onFailure {
+                status = context.getString(R.string.update_failed, it.message.orEmpty())
+            }
+        }
+    }
+
+    // Checked on open rather than only on tap: a screen called "Updater" that says nothing until
+    // prodded is just a button with extra steps.
