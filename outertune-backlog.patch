From 625d30c4587ba3679997a553b33d0ac3efbbbf85 Mon Sep 17 00:00:00 2001
From: yuuichi <6133780+yuuichi-s@users.noreply.github.com>
Date: Thu, 13 Aug 2026 17:37:53 +0900
Subject: [PATCH 085/180] fix: prevent concurrent home pagination requests

Set the loading flag only when no home pagination request is already running. Perform the check and update as a single operation so that simultaneous load-more requests start only one network call.

Always clear the loading flag when the request finishes or is cancelled so that later load-more requests can proceed.

(cherry picked from commit 84b4fd4f7c4439bfd1f2ac1d5d7c245a08b79784)
---
 .../outertune/viewmodels/HomeViewModel.kt     | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/viewmodels/HomeViewModel.kt b/app/src/main/java/com/dd3boh/outertune/viewmodels/HomeViewModel.kt
index 14d91ba2..22af1f35 100644
--- a/app/src/main/java/com/dd3boh/outertune/viewmodels/HomeViewModel.kt
+++ b/app/src/main/java/com/dd3boh/outertune/viewmodels/HomeViewModel.kt
@@ -155,19 +155,20 @@ class HomeViewModel @Inject constructor(
 
     private val _isLoadingMore = MutableStateFlow(false)
     fun loadMoreYouTubeItems(continuation: String?) {
-        if (continuation == null || _isLoadingMore.value) return
+        if (continuation == null) return
 
         viewModelScope.launch(Dispatchers.IO) {
-            _isLoadingMore.value = true
-            val nextSections = YouTube.home(continuation).getOrNull() ?: run {
+            if (!_isLoadingMore.compareAndSet(false, true)) return@launch
+
+            try {
+                val nextSections = YouTube.home(continuation).getOrNull() ?: return@launch
+                homePage.value = nextSections.copy(
+                    chips = homePage.value?.chips,
+                    sections = homePage.value?.sections.orEmpty() + nextSections.sections
+                )
+            } finally {
                 _isLoadingMore.value = false
-                return@launch
             }
-            homePage.value = nextSections.copy(
-                chips = homePage.value?.chips,
-                sections = homePage.value?.sections.orEmpty() + nextSections.sections
-            )
-            _isLoadingMore.value = false
         }
     }
 
-- 
