From 4938a8ffd13ac9144e1a96caffb550d22a7173b8 Mon Sep 17 00:00:00 2001
From: claude <claude@local>
Date: Fri, 28 Aug 2026 17:55:13 +0800
Subject: [PATCH 193/249] Exclude innertubex's desktop artifact so the release
 build packages

The JitPack-published Gradle metadata for innertubex does not resolve to
a single platform variant, so the root module brought in the desktop JVM
jar alongside the Android aar. Every class then exists twice and
checkCoreReleaseDuplicateClasses fails the build - with no compiler
error, which is why the workflow's error extraction reported nothing and
the summary said the failure was somewhere else.

Excluding the desktop artifact keeps the root module's own dependency
declarations while leaving only the Android one on the classpath.

Verified by assembling coreRelease, the variant the workflow actually
builds by default, rather than only compiling fullDebug as before:
compileCoreReleaseKotlin, checkCoreReleaseDuplicateClasses, R8 (no
missing-class warnings) and lintVital all pass. The build now gets as far
as packaging and stops only on the release keystore, which exists on CI
and not here.
---
 app/build.gradle.kts | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index c5eba0e6..2738df0e 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -266,7 +266,13 @@ dependencies {
 
     // modules
     implementation(project(":innertube"))
-    implementation("com.github.MetrolistGroup:innertubex:v0.2.6")
+    // The JitPack-published Gradle metadata does not resolve a single platform variant, so the
+    // root module drags in the desktop JVM jar alongside the Android aar and every class lands
+    // twice - checkDuplicateClasses fails the release build. Excluding the desktop artifact
+    // keeps the root module's own dependency declarations while leaving just the Android one.
+    implementation("com.github.MetrolistGroup:innertubex:v0.2.6") {
+        exclude(group = "com.github.MetrolistGroup.innertubex", module = "innertubex-desktop")
+    }
     // Ktor on the app classpath too: the innertubex stream resolver builds its own client,
     // and :innertube keeps these implementation-scoped rather than exposing them.
     implementation(libs.ktor.client.core)
