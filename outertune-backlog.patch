+            val naturalAspect = remember(thumbnail) { thumbnail?.naturalAspectRatioOrNull() }
+            val headerAspect = (naturalAspect ?: (4f / 3)).coerceIn(0.9f, 2.2f)
+
             Column {
                 Box(
                     modifier = Modifier
