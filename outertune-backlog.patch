From 08a736c7de6f2a35cf3e3ac7a3334d681d7b3510 Mon Sep 17 00:00:00 2001
From: claude <claude@local>
Date: Fri, 28 Aug 2026 19:16:20 +0800
Subject: [PATCH 196/249] Give the ferrofluid blobs a tint instead of pure
 black

The blobs were rendering as flat black. baseColor was passed the surface
role straight through, and in a dark scheme that role is already
near-black, so the lit term had nothing of the theme left in it to carry -
the body read as a hole in the background rather than an object in it.

Blends black with the accent instead, black-dominant so the material
still reads as ink: the unlit faces stay black and the lit ones pick up
enough of the current theme to belong to it. Kept well down at 0.18;
past roughly a fifth it stops looking like ferrofluid and starts looking
like coloured plastic.

The specular and Fresnel terms are untouched - those were already themed
and were the only colour in there before.
---
 .../com/dd3boh/outertune/ui/player/LiquidBackground.kt   | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/dd3boh/outertune/ui/player/LiquidBackground.kt b/app/src/main/java/com/dd3boh/outertune/ui/player/LiquidBackground.kt
index 7bd3459d..4163cf1f 100644
--- a/app/src/main/java/com/dd3boh/outertune/ui/player/LiquidBackground.kt
+++ b/app/src/main/java/com/dd3boh/outertune/ui/player/LiquidBackground.kt
@@ -321,7 +321,14 @@ fun LiquidBackground(
                 // surface supplies that darkness while still following the scheme.
                 highlightColor = accentColor,
                 rimColor = MaterialTheme.colorScheme.tertiary,
-                baseColor = MaterialTheme.colorScheme.surface,
+                // Ferrofluid is a black body, and it should read as one - but passing the surface
+                // role straight through made it *only* black, since in a dark scheme that role is
+                // already near-black and the lit term had nothing of the theme left in it to carry.
+                // A black-dominant blend keeps the material looking like ink while letting the
+                // accent show in the lit faces, so the blobs belong to the current theme instead of
+                // being holes in it. Weighted well down: past roughly a fifth it stops looking like
+                // ferrofluid and starts looking like coloured plastic.
+                baseColor = lerp(Color.Black, accentColor, 0.18f),
                 quality = ferrofluidQuality,
                 modifier = baseModifier,
                 fallback = { FerrofluidCanvasShape(baseModifier, flowTime, seed, bass, treble, transient, alpha) },
