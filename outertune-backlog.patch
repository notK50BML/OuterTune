--- a/app/src/main/java/com/dd3boh/outertune/ui/component/KaraokeLyricLine.kt
+++ b/app/src/main/java/com/dd3boh/outertune/ui/component/KaraokeLyricLine.kt
@@ -86,8 +86,12 @@ fun KaraokeLyricLine(
 
         // Without a width there is nothing to lay out against, and without text or timings there is
