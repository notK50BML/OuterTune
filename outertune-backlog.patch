                     fun pointAt(i: Int): Offset {
                         val index = ((i % sampleCount) + sampleCount) % sampleCount
-                        val angle = tau * index / sampleCount
+                        val angle = tau * index / sampleCount + spin
                         val r = radii[index]
                         return Offset(cx + r * cos(angle), cy + r * sin(angle))
                     }
